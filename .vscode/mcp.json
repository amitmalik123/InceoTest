{
  "servers": {
    "dm1-test-framework": {
      "type": "stdio",
      "command": "python",
      "args": [
        "ai/mcp/server.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    "microsoftdocs/mcp": {
			"type": "http",
			"url": "https://learn.microsoft.com/api/mcp"
		},
		"atlassian": {
      		"type": "http",
      		"url": "https://mcp.atlassian.com/v1/mcp"
    	},
		"microsoft/playwright-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			]
		}
  }
}
