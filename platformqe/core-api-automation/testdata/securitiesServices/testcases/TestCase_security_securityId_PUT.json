    {
        "test_id": "TC001",
        "service_name": "securitiesServices",
        "workflow_mode": "parallel",
        "test_name": "POST /security [validation: securityId invalid] (TC001)",
        "protocol": "REST",
        "test_type": [
            "Negative",
            "Validation"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/security/{{invalid_securityId}}?name={{random_string(7)}}&ticker={{random_string(5)}}&cusip={{random_string(9)}}",
        "method": "PUT",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "400",
        "expected_response_schema": "",
        "expected_response": null,
        "ignore_fields": [],
        "extract_values": [
            {
                "from": "response",
                "key": "status",
                "assign_to": "error_status"
            },
            {
                "from": "response",
                "key": "errors.securityId.0",
                "assign_to": "securityId_error_message"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 650
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{error_status}}",
                    "operator": "==",
                    "expected": 400,
                    "message": "Expected error status to be 400"
                },
                {
                    "actual": "{{securityId_error_message}}",
                    "operator": "contains",
                    "expected": "The value",
                    "message": "Expected securityId error message to include the invalid securityId value"
                },
                {
                    "actual": "{{securityId_error_message}}",
                    "operator": "contains",
                    "expected": "{{invalid_securityId}}",
                    "message": "Expected securityId error message to include the invalid securityId value"
                },
                {
                    "actual": "{{securityId_error_message}}",
                    "operator": "contains",
                    "expected": "is not valid.",
                    "message": "Expected securityId error message to include the invalid securityId value"
                }
            ]
        },
        "test_data_file": "securitiesServices/data_driven/Data_security_PUT.csv",
        "db_query": "",
        "db_type": "",
        "db_connection_name": "",
        "test_summary": "Test TC000: Validate securityId invalid error using assertions",
        "test_scenario": "Extract error response fields and validate them using assertions. Checks title, status, and securityId-specific error message."
    },
    {
        "test_id": "TC002",
        "service_name": "securitiesServices",
        "workflow_mode": "parallel",
        "test_name": "POST /security [validation: update too short cusip] (TC002)",
        "protocol": "REST",
        "test_type": [
            "Negative",
            "Validation"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/security/{{valid_securityId}}?name={{random_string(7)}}&ticker={{random_string(5)}}&cusip={{random_string(8)}}",
        "method": "PUT",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "422",
        "expected_response_schema": "",
        "expected_response": null,
        "ignore_fields": [],
        "extract_values": [
            {
                "from": "response",
                "key": "type",
                "assign_to": "error_type"
            },
            {
                "from": "response",
                "key": "title",
                "assign_to": "error_title"
            },
            {
                "from": "response",
                "key": "status",
                "assign_to": "error_status"
            },
            {
                "from": "response",
                "key": "detail",
                "assign_to": "error_detail"
            },
            {
                "from": "response",
                "key": "instance",
                "assign_to": "error_instance"
            },
            {
                "from": "response",
                "key": "errors.cusip.0",
                "assign_to": "cusip_error_message"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 650
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{error_type}}",
                    "operator": "==",
                    "expected": "business-rule-violation",
                    "message": "Expected error type to be 'business-rule-violation'"
                },
                {
                    "actual": "{{error_title}}",
                    "operator": "==",
                    "expected": "Business Rule Violation",
                    "message": "Expected error title to be 'Business Rule Violation'"
                },
                {
                    "actual": "{{error_status}}",
                    "operator": "==",
                    "expected": 422,
                    "message": "Expected error status to be 422"
                },
                {
                    "actual": "{{error_detail}}",
                    "operator": "==",
                    "expected": "The request is invalid and not meeting business rules requirements",
                    "message": "Expected details to mention 'The request is invalid and not meeting business rules requirements'"
                },
                {
                    "actual": "{{error_instance}}",
                    "operator": "contains",
                    "expected": "/api/security/v1/security",
                    "message": "Expected instance to be '/api/security/v1/security'"
                },
                {
                    "actual": "{{error_instance}}",
                    "operator": "contains",
                    "expected": "{{valid_securityId}}",
                    "message": "Expected instance to be '/api/security/v1/security'"
                },
                {
                    "actual": "{{cusip_error_message}}",
                    "operator": "contains",
                    "expected": "Cusip must be 9 alphanumeric characters. Provided Cusip",
                    "message": "Expected cusip error message to include the invalid cusip value"
                },
                {
                    "actual": "{{cusip_error_message}}",
                    "operator": "contains",
                    "expected": "is too short.",
                    "message": "Expected cusip error message to include 'is too short' text"
                }
            ]
        },
        "test_data_file": "securitiesServices/data_driven/Data_security_PUT.csv",
        "db_query": "",
        "db_type": "",
        "db_connection_name": "",
        "test_summary": "Test TC002: Validate too short cusip error using assertions",
        "test_scenario": "Extract error response fields and validate them using assertions. Checks title, status, and cusip-specific error message."
    },
