[
    {
        "test_id": "TC001",
        "service_name": "securitiesServices",
        "workflow_mode": "parallel",
        "test_name": "POST /security [validation: CUSIP too short] (TC001)",
        "protocol": "REST",
        "test_type": [
            "Negative",
            "Validation"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/security?subAssetTypeId=51010&cusip=VCXT54&name=NEW_RECORD",
        "method": "POST",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "422",
        "expected_response_schema": "",
        "expected_response": null,
        "ignore_fields": [],
        "extract_values": [
            {
                "from": "response",
                "key": "type",
                "assign_to": "error_type"
            },
            {
                "from": "response",
                "key": "title",
                "assign_to": "error_title"
            },
            {
                "from": "response",
                "key": "status",
                "assign_to": "error_status"
            },
            {
                "from": "response",
                "key": "detail",
                "assign_to": "error_detail"
            },
            {
                "from": "response",
                "key": "instance",
                "assign_to": "error_instance"
            },
            {
                "from": "response",
                "key": "errors.cusip.0",
                "assign_to": "cusip_error_message"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 500
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{error_type}}",
                    "operator": "==",
                    "expected": "business-rule-violation",
                    "message": "Expected error type to be 'business-rule-violation'"
                },
                {
                    "actual": "{{error_title}}",
                    "operator": "==",
                    "expected": "Business Rule Violation",
                    "message": "Expected error title to be 'Business Rule Violation'"
                },
                {
                    "actual": "{{error_status}}",
                    "operator": "==",
                    "expected": 422,
                    "message": "Expected error status to be 422"
                },
                {
                    "actual": "{{error_detail}}",
                    "operator": "==",
                    "expected": "The request is invalid and not meeting business rules requirements",
                    "message": "Expected detail message about business rules"
                },
                {
                    "actual": "{{error_instance}}",
                    "operator": "==",
                    "expected": "/api/security/v1/security",
                    "message": "Expected instance to be '/api/security/v1/security'"
                },
                {
                    "actual": "{{cusip_error_message}}",
                    "operator": "contains",
                    "expected": "too short",
                    "message": "Expected CUSIP error message to mention 'too short'"
                },
                {
                    "actual": "{{cusip_error_message}}",
                    "operator": "contains",
                    "expected": "VCXT54",
                    "message": "Expected CUSIP error message to include the invalid CUSIP value"
                },
                {
                    "actual": "{{cusip_error_message}}",
                    "operator": "contains",
                    "expected": "9 alphanumeric characters",
                    "message": "Expected CUSIP error message to specify the validation rule"
                }
            ]
        },
        "test_data_file": "",
        "db_query": "",
        "db_type": "",
        "db_connection_name": "",
        "test_summary": "Test TC001: Validate CUSIP too short error using assertions",
        "test_scenario": "Extract error response fields and validate them using assertions. Checks error type, title, status, detail, instance, and CUSIP-specific error message."
    },
