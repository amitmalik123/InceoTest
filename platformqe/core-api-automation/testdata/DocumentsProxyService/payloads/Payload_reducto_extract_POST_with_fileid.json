{
  "async": {
    "priority": false,
    "metadata": {},
    "webhook": {
      "mode": "direct",
      "url": "https://your-webhook-endpoint.com/callback"
    }
  },
  "input": "{{fileId}}",
  "parsing": {
    "enhance": {
      "agentic": [
        {
          "scope": "table",
          "prompt": "Custom prompt for table extraction"
        },
        {
          "scope": "figure",
          "prompt": "Custom prompt for figure extraction",
          "advanced_chart_agent": false,
          "return_overlays": false
        },
        {
          "scope": "text",
          "prompt": "Custom instructions for key-value form regions"
        }
      ],
      "summarize_figures": true,
      "intelligent_ordering": false
    },
    "retrieval": {
      "chunking": {
        "chunk_mode": "variable",
        "chunk_size": 1000,
        "chunk_overlap": 0
      },
      "filter_blocks": [
        "Header",
        "Footer",
        "Title",
        "Section Header",
        "Page Number",
        "List Item",
        "Figure",
        "Table",
        "Key Value",
        "Text",
        "Comment",
        "Signature"
      ],
      "embedding_optimized": false
    },
    "formatting": {
      "add_page_markers": false,
      "table_output_format": "dynamic",
      "merge_tables": false,
      "include": [
        "change_tracking",
        "highlight",
        "comments",
        "hyperlinks",
        "signatures",
        "ignore_watermarks"
      ]
    },
    "spreadsheet": {
      "split_large_tables": {
        "enabled": true,
        "size": {
          "row": 50,
          "column": 10
        }
      },
      "include": [
        "cell_colors",
        "formula",
        "dropdowns"
      ],
      "clustering": "accurate",
      "exclude": [
        "hidden_sheets",
        "hidden_rows",
        "hidden_cols",
        "styling",
        "spreadsheet_images"
      ]
    },
    "settings": {
      "ocr_system": "standard",
      "extraction_mode": "hybrid",
      "force_url_result": false,
      "force_file_extension": ".pdf",
      "return_ocr_data": false,
      "return_images": [
        "figure",
        "table",
        "page"
      ],
      "embed_pdf_metadata": false,
      "persist_results": false,
      "timeout": 120,
      "page_range": {
        "start": 1,
        "end": 10
      },
      "document_password": "secret123"
    }
  },
  "instructions": {
    "schema": {
      "type": "object",
      "properties": {
        "field_name": {
          "type": "string",
          "description": "Description of the field"
        }
      }
    },
    "system_prompt": "Be precise and thorough."
  },
  "settings": {
    "include_images": false,
    "optimize_for_latency": false,
    "array_extract": false,
    "citations": {
      "enabled": false,
      "numerical_confidence": true
    }
  }
}
