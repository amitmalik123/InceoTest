{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "POST /Permissions/groups Error Response Schema (No Instance)",
  "description": "Error response schema for /Permissions/groups when 'instance' is not present, but 'type' and 'traceId' are.",
  "properties": {
    "title": { "type": "string" },
    "status": { "type": "integer" },
    "type": { "type": "string" },
    "errors": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "traceId": { "type": "string" }
  },
  "required": ["title", "status", "instance", "errors"]
}
