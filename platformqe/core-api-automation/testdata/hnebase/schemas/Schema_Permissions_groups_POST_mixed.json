{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "POST /Permissions/groups Response Schema (Mixed)",
  "description": "Response schema for /Permissions/groups when response has mix of valid and no-match groupnames",
  "properties": {
    "permissionGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groupName": { "type": "string" },
          "permissions": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "permissionKey": { "type": "string" },
                    "permissionEffect": { "type": "string" }
                  },
                  "required": ["permissionKey", "permissionEffect"]
                }
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": ["groupName", "permissions"]
      }
    }
  },
  "required": ["permissionGroups"]
}
