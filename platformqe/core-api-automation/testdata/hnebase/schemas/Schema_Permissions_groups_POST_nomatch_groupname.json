{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "POST /Permissions/groups Response Schema (No Match GroupName)",
  "description": "Response schema for /Permissions/groups when groupname doesn't match",
  "properties": {
    "permissionGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groupName": { "type": "string" },
          "permissions": { "type": "string" }
        },
        "required": ["groupName", "permissions"]
      }
    }
  },
  "required": ["permissionGroups"]
}
