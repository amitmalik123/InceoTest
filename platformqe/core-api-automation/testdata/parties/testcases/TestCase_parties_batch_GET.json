    {
        "test_id": "TC001",
        "service_name": "parties",
        "workflow_mode": "parallel",
        "test_name": "Batch GET - Valid request with all existing Party IDs returns 200 OK with full party objects",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Smoke",
            "Regression"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/parties/batch?partyIds={{partyId1}}&partyIds={{partyId2}}&partyIds={{partyId3}}",
        "method": "GET",
        "rpc_method": "",
        "graphql_query": "",
        "graphql_variables": "",
        "soap_action": "",
        "soap_envelope": "",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "200",
        "expected_response_schema": "",
        "expected_response": null,
        "ignore_fields": [],
        "extract_values": [
            {
                "from": "response",
                "record_count": true,
                "array_path": "$.parties",
                "assign_to": "response_party_count"
            },
            {
                "from": "response",
                "key": "$.parties[0].partyId",
                "assign_to": "first_party_id"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 1000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "response_validations": [
                {
                    "field": "$.parties",
                    "condition": "is_array",
                    "error_message": "Response must have a parties array"
                },
                {
                    "field": "$.parties",
                    "condition": "array_length_equals",
                    "expected_value": 3,
                    "error_message": "Response must contain exactly 3 party objects"
                },
                {
                    "field": "$.parties[*].partyId",
                    "condition": "not_null",
                    "error_message": "Each party object must have a partyId"
                },
                {
                    "field": "$.parties[*].partyType",
                    "condition": "not_null",
                    "error_message": "Each party object must have a partyType"
                }
            ],
            "data_comparison": []
        },
        "test_data_file": "parties/data_driven/Data_parties_batch_GET.csv",
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT * FROM Party WHERE Id IN ('{{partyId1}}', '{{partyId2}}', '{{partyId3}}')",
            "audit_query": ""
        },
        "db_type": "mssql",
        "db_connection_name": "parties",
        "test_summary": "AC1: Verify that a valid GET request with all existing Party IDs returns 200 OK with full party objects for all requested IDs"
    },
