                "variable_name": "returned_pageSize"
            },
            {
                "response_field": "total",
                "variable_name": "returned_total"
            },
            {
                "response_field": "items[0].partyId",
                "variable_name": "first_partyId"
            }
        ],
        "validate": {
            "response_structure": {
                "required_fields": [
                    "page",
                    "pageSize",
                    "total",
                    "items"
                ],
                "items_structure": {
                    "required_fields": [
                        "partyId",
                        "status",
                        "partyType"
                    ],
                    "conditional_fields": [
                        {
                            "when": "partyType == 'Individual'",
                            "required": [
                                "firstName",
                                "lastName"
                            ]
                        },
                        {
                            "when": "partyType in ['Entity', 'Trust']",
                            "required": [
                                "title"
                            ]
                        }
                    ]
                }
            },
            "pagination": {
                "validate_page_equals": 1,
                "validate_pageSize_equals": 50,
                "validate_total_is_positive": true,
                "validate_items_length_matches_pageSize": true
            },
            "sorting": {
                "field": "partyId",
                "order": "asc",
                "validate_sort_order": true
            },
            "business_rules": [
                {
                    "rule": "Only latest version per partyId",
                    "validation": "unique_partyIds"
                },
                {
                    "rule": "All items have valid status",
                    "validation": "status in ['DRAFT', 'IN-PROCESS', 'CONFIRMED', 'Draft', 'Pending']"
                },
                {
                    "rule": "All partyIds are non-empty GUIDs",
                    "validation": "partyId matches UUID pattern"
                },
                {
                    "rule": "Response contains at least one item",
                    "validation": "items length > 0"
                }
            ],
            "performance": {
                "max_response_time_ms": 2000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss",
                    "sensitive_data_exposure"
                ]
            }
        },
        "test_data_file": "parties/data_driven/Data_parties_householdid_GET.csv",
        "db_query_timing": "after_api",
        "db_queries": {
            "audit_query": "SELECT HouseholdId as db_id FROM [dbo].[Party] WHERE HouseholdId = '{{householdId}}';",
            "count_query": "SELECT COUNT(DISTINCT PartyId) as party_count FROM [dbo].[Party] WHERE HouseholdId = '{{householdId}}';",
            "version_query": "SELECT PartyId, MAX(Version) as max_version FROM [dbo].[Party] WHERE HouseholdId = '{{householdId}}' GROUP BY PartyId;"
        },
        "db_validations": [
            {
                "query": "count_query",
                "assertion": "party_count equals response.total"
            },
            {
                "query": "version_query",
