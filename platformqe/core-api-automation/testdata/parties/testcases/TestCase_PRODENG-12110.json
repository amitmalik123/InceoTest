        "target": "db_result",
        "format": "table",
        "key_field": ["", ""],
        "fields_to_compare": [
          {
            "source": "parties.0.core.individual.dateOfBirth",
            "target": "db_individual_dob"
          },
          {
            "source": "parties.0.core.individual.dateOfDeath",
            "target": "db_date_of_death"
          },
          {
            "source": "parties.0.core.entity.createdDate",
            "target": "db_entity_created_date"
          }
        ],
        "log_differences": true
      },
      "format_validation": {
        "date_only_fields": [
          "api_individual_dob",
          "api_date_of_death",
          "api_entity_created_date"
        ],
        "date_only_pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "assertions": [
        {
          "actual": "{{api_individual_dob}}",
          "operator": "!=",
          "expected": "",
