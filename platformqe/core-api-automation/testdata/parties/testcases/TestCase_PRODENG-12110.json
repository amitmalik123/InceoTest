      {
        "from": "api_response",
        "key": "parties.0.core.entity.createdDate",
        "assign_to": "api_entity_created_date"
      },
      {
        "from": "db_result",
        "query": "SELECT CONVERT(varchar(10), IndividualDateOfBirth, 23) as db_individual_dob,\n       CONVERT(varchar(10), DateOfDeath, 23)              as db_date_of_death,\n       CONVERT(varchar(10), EntityCreatedDate, 23)        as db_entity_created_date\nFROM [dbo].[Party]\nWHERE Id = '{{id}}';",
        "assign": [
          {
            "key": "0.db_individual_dob",
            "assign_to": "db_individual_dob"
          },
          {
            "key": "0.db_date_of_death",
            "assign_to": "db_date_of_death"
          },
          {
            "key": "0.db_entity_created_date",
            "assign_to": "db_entity_created_date"
          }
        ]
      }
    ],
    "validate": {
      "performance": {
        "max_response_time_ms": 500
      },
      "security": {
        "checks": ["sql_injection", "xss"]
      },
      "data_comparison": {
