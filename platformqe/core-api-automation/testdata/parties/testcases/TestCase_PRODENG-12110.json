    "ignore_fields": [
      "parties.0.partyId",
      "parties.0.createdDate",
      "parties.0.updatedDate"
    ],
    "extract_values": [
      {
        "from": "api_response",
        "key": "parties.0.core.individual.dateOfBirth",
        "assign_to": "api_individual_dob"
      },
      {
        "from": "api_response",
        "key": "parties.0.core.individual.dateOfDeath",
        "assign_to": "api_date_of_death"
