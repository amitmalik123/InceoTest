{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "page": {
      "type": "integer"
    },
    "pageSize": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "partyType": {
            "type": "string"
          },
          "firstName": {
            "type": ["string", "null"]
          },
          "lastName": {
            "type": ["string", "null"]
          },
          "title": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "partyId",
          "status",
          "partyType"
        ]
      }
    }
  },
  "required": [
    "page",
    "pageSize",
    "total",
    "items"
  ]
}
