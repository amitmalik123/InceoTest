{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "parties": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": ["string", "null"]
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["Draft", "Pending", "Confirmed", null]
          },
          "version": {
            "type": "integer"
          },
          "partyType": {
            "type": ["string", "null"],
            "enum": ["Individual", "Business", "Trust"]
          },
          "core": {
            "type": "object",
            "properties": {
              "individual": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": ["string", "null"],
                    "maxLength": 50
                  },
                  "middleName": {
                    "type": ["string", "null"],
                    "maxLength": 50
                  },
                  "lastName": {
                    "type": ["string", "null"],
                    "maxLength": 50
                  },
                  "suffix": {
                    "type": ["string", "null"],
                    "maxLength": 50
                  },
                  "dateOfBirth": {
                    "type": ["string", "null"],
                    "format": "date"
                  },
                  "taxId": {
                    "type": ["string", "null"],
                    "maxLength": 9
                  },
                  "citizenship": {
                    "type": ["string", "null"],
                    "enum": [
                      "Unknown",
                      "BirthRight",
                      "Naturalization",
                      "NonCitizen",
                      null
                    ]
                  },
                  "maritalStatus": {
                    "type": ["string", "null"],
                    "enum": [
                      "Unknown",
                      "Single",
                      "Married",
                      "Divorced",
                      "Widow",
                      "Widower",
                      "Cohabiting",
                      "CivilUnion",
                      "DomesticPartnership",
                      "UnmarriedPartners",
                      null
                    ]
                  },
                  "isDeceased": {
                    "type": ["boolean", "null"]
                  },
                  "dateOfDeath": {
                    "type": ["string", "null"],
                    "format": "date"
                  }
                }
              },
              "entity": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["Business", "Trust"]
                  },
                  "subType": {
                    "type": "string",
                    "enum": [
                      "Unknown",
                      "FamilyTrust",
                      "IrrevocableTrust",
                      "LivingTrust",
                      "RevocableTrust",
                      "TestamentaryTrust",
                      "IrrevocableLivingTrust",
                      "CharitableTrust"
                    ]
                  },
                  "title": {
                    "type": ["string", "null"],
                    "maxLength": 100
                  },
                  "taxId": {
                    "type": ["string", "null"],
                    "maxLength": 11
                  },
                  "taxidentifier": {
                    "type": "string",
                    "enum": ["SSN", "EIN"]
                  },
                  "createdDate": {
                    "type": ["string", "null"],
                    "format": "date"
                  }
                }
              }
            }
          },
          "addresses": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "addressId": {
                  "type": ["string", "null"]
                },
                "addressType": {
                  "type": "string",
                  "enum": [
                    "Business",
                    "Residence",
                    "Mailing",
                    "Billing",
                    "Previous",
                    "AffiliationsEmployer",
                    "AffiliationsPubliclyTradedCompany"
                  ]
                },
                "line1": {
                  "type": ["string", "null"],
                  "maxLength": 60,
                  "minLength": 1
                },
                "line2": {
                  "type": ["string", "null"],
                  "maxLength": 60,
                  "minLength": 1
                },
                "city": {
                  "type": ["string", "null"],
                  "maxLength": 50,
                  "minLength": 1
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "AL",
                    "OH",
                    "AK",
                    "AZ",
                    "OK",
                    "AR",
                    "CA",
                    "OR",
                    "CO",
                    "CT",
                    "PA",
                    "DE",
                    "FL",
                    "RI",
                    "GA",
                    "HI",
                    "ID",
                    "IL",
                    "IN",
                    "IA",
                    "SC",
                    "KS",
                    "KY",
                    "SD",
                    "LA",
                    "ME",
                    "TN",
                    "MD",
                    "MA",
                    "TX",
                    "MI",
                    "MN",
                    "MS",
                    "MO",
                    "MT",
                    "NE",
                    "UT",
                    "NV",
                    "NH",
                    "VT",
                    "NJ",
                    "NM",
                    "NY",
                    "VA",
                    "NC",
                    "ND",
                    "WA",
                    "WV",
                    "WI",
                    "WY"
                  ]
                },
                "zip": {
                  "type": ["string", "null"],
                  "maxLength": 5,
                  "minLength": 1
                },
                "country": {
                  "type": "string"
                },
                "priorityType": {
                  "type": "string",
                  "enum": ["Primary", "Secondary", "Alternative", "Unknown"]
                }
              }
            }
          },
          "contacts": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "contactId": {
                  "type": ["string", "null"]
                },
                "contactType": {
                  "type": "string",
                  "enum": ["Phone", "Email"]
                },
                "usageType": {
                  "type": "string",
                  "enum": [
                    "Unknown",
                    "Personal",
                    "Work",
                    "Business",
                    "DayTime",
                    "Home",
                    "Cellular"
                  ]
                },
                "value": {
                  "type": ["string", "null"],
                  "maxLength": 255
                },
                "priorityType": {
                  "type": "string",
                  "enum": ["Primary", "Secondary", "Alternative", "Unknown"]
                }
              }
            }
          },
          "identifiers": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "identifierId": {
                  "type": ["string", "null"]
                },
                "type": {
                  "type": "string",
                  "enum": ["APL", "BETA", "RedTail", "WealthFrontID"]
                },
                "value": {
                  "type": ["string", "null"],
                  "maxLength": 255
                }
              }
            }
          },
          "householdId": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
