{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PagedParties",
  "type": "object",
  "properties": {
    "pagedParties": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "partyId": { "type": "string", "format": "uuid" },
              "partyType": { "type": "string" },
              "status": { "type": "string" },

              "core": {
                "type": "object",
                "properties": {
                  "individual": {
                    "type": "object",
                    "properties": {
                      "firstName": { "type": "string" },
                      "middleName": { "type": ["string", "null"] },
                      "lastName": { "type": "string" },
                      "suffix": { "type": ["string", "null"] },
                      "dateOfBirth": { "type": "string", "format": "date-time" },
                      "taxId": { "type": ["string", "null"] },
                      "citizenship": { "type": "string" },
                      "maritalStatus": { "type": "string" },
                      "isDeceased": { "type": "boolean" },
                      "dateOfDeath": { "type": ["string", "null"] }
                    },
                    "required": [
                      "firstName",
                      "lastName",
                      "dateOfBirth",
                      "citizenship",
                      "maritalStatus",
                      "isDeceased"
                    ]
                  },

                  "entity": {
                    "type": "object",
                    "properties": {
                      "type": { "type": ["string", "null"] },
                      "subType": { "type": ["string", "null"] },
                      "title": { "type": ["string", "null"] },
                      "taxId": { "type": ["string", "null"] },
                      "taxidentifier": { "type": "string" },
                      "createdDate": { "type": ["string", "null"] }
                    }
                  }
                },
                "required": ["individual", "entity"]
              },

              "addresses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "addressType": { "type": "string" },
                    "line1": { "type": ["string", "null"] },
                    "line2": { "type": ["string", "null"] },
                    "city": { "type": "string" },
                    "state": { "type": "string" },
                    "zip": { "type": "string" },
                    "country": { "type": "string" },
                    "priorityType": { "type": "string" }
                  },
                  "required": [
                    "addressType",
                    "city",
                    "state",
                    "zip",
                    "country",
                    "priorityType"
                  ]
                }
              },

              "contacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "contactType": { "type": "string" },
                    "usageType": { "type": "string" },
                    "value": { "type": "string" },
                    "priorityType": { "type": "string" }
                  },
                  "required": [
                    "contactType",
                    "usageType",
                    "value",
                    "priorityType"
                  ]
                }
              },

              "identifiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string" },
                    "value": { "type": "string" }
                  },
                  "required": ["type", "value"]
                }
              }
            },

            "required": [
              "partyId",
              "partyType",
              "status",
              "core",
              "addresses",
              "contacts",
              "identifiers"
            ]
          }
        },

        "totalCount": { "type": "integer" },
        "page": { "type": "integer" },
        "pageSize": { "type": "integer" },
        "totalPages": { "type": "integer" },
        "hasPreviousPage": { "type": "boolean" },
        "hasNextPage": { "type": "boolean" }
      },

      "required": [
        "items",
        "totalCount",
        "page",
        "pageSize",
        "totalPages",
        "hasPreviousPage",
        "hasNextPage"
      ]
    }
  },
  "required": ["pagedParties"]
}
