{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "POST /custodialservicing/accounts 202 Accepted Response Schema",
  "description": "Success response schema for Beneficiary Change endpoint",
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["accepted", "message", "correlationId", "acceptedAt"]
}
