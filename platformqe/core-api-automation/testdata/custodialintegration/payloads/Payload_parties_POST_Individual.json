{
  "partyType": "Individual",
  "status": "Draft",
  "core": {
    "individual": {
      "firstName": "{{ random_string(6) }}",
      "middleName": "{{ random_string(6) }}",
      "lastName": "{{ random_string(6) }}",
      "suffix": "string",
      "dateOfBirth": "{{ random_date('-70y', 'today', '%Y-%m-%d') }}",
      "taxId": "{{ random_numeric(9) }}",
      "citizenship": "{{ alternate('Unknown', 'BirthRight', 'Naturalization', 'NonCitizen') }}",
      "maritalStatus": "{{ alternate('Unknown', 'Single', 'Married', 'Divorced', 'Widow', 'Widower', 'Cohabiting', 'CivilUnion', 'DomesticPartnership', 'UnmarriedPartners') }}",
      "isDeceased": false,
      "dateOfDeath": null
    }, 
    "entity": null
  },
  "addresses": [
    {
      "addressType": "Residence",
      "line1": "{{ random_int(1, 30) }} street",
      "line2": "{{ random_int(1, 100) }}th avenue",
      "city": "{{ alternate('Phoenix', 'Tucson', 'Mesa') }}",
      "state": "AZ",
      "zip": "{{ alternate('85001', '85002', '85003') }}",
      "country": "US",
      "priorityType": "Primary"
    }
  ],
  "contacts": [
    {
      "contactType": "Phone",
      "usageType":"{{ alternate('Unknown', 'Personal', 'Work', 'Business', 'DayTime', 'Home', 'Cellular') }}",
      "value": "{{ random_numeric(10) }}",
      "priorityType": "Primary"
    },
    {
      "contactType": "Email",
      "usageType":"{{ alternate('Unknown', 'Personal', 'Work', 'Business', 'DayTime', 'Home', 'Cellular') }}",
      "value": "{{ random_email() }}",
      "priorityType": "Secondary"
    }
  ],
  "identifiers": [
    {
      "type": "APL",
      "value": "string"
    }
  ],
  "householdId": "string"
}