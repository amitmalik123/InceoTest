  {
    "test_id": "TC001",
    "service_name": "custodialintegration",
    "workflow_mode": "parallel",
    "test_name": "Beneficiary Change - Happy path: valid payload returns 202 Accepted [positive] (TC001)",
    "protocol": "REST",
    "test_type": ["Functional"],
    "mainURL": "{{base_url}}",
    "endpoint": "/custodialservicing/accounts",
    "method": "POST",
    "rpc_method": "",
    "graphql_query": "",
    "graphql_variables": "",
    "soap_action": "",
    "soap_envelope": "",
    "headers_additional": {
      "Content-Type": "application/json"
    },
    "payload": "custodialintegration\\payloads\\Payload_custodialservicing_accounts_POST_functional.json",
    "expected_status": "202",
    "expected_response_schema": "custodialintegration\\schemas\\Schema_custodialservicing_accounts_POST.json",
    "expected_response": null,
    "ignore_fields": ["id"],
    "extract_values": [
      {
        "from": "response",
        "key": "accepted",
        "assign_to": "accepted_flag"
      },
      {
        "from": "response",
        "key": "message",
        "assign_to": "response_message"
      },
      {
        "from": "response",
        "key": "correlationId",
        "assign_to": "correlation_id"
      }
    ],
    "validate": {
      "performance": {
        "max_response_time_ms": 500
      },
      "security": {
        "checks": ["sql_injection", "xss"]
      },
      "assertions": [
        {
          "actual": "{{accepted_flag}}",
          "operator": "==",
          "expected": true,
          "message": "Expected 'accepted' to be true"
        },
        {
          "actual": "{{response_message}}",
          "operator": "==",
          "expected": "Request accepted for processing.",
          "message": "Expected message to be 'Request accepted for processing.'"
        },
        {
          "actual": "{{correlation_id}}",
          "operator": "!=",
          "expected": "",
          "message": "Expected correlationId to be non-empty"
        }
      ]
    },
    "test_data_file": "",
    "test_summary": "Test TC001: Happy path - Valid Beneficiary Change payload with multiple accounts and parties returns 202 Accepted"
  },
