    "test_id": "TC000",
    "service_name": "custodialintegration",
    "workflow_mode": "sequential",
    "test_name": "DB_ONLY - Fetch valid accountId from Accounts database (TC000)",
    "protocol": "DB_ONLY",
    "test_type": ["setup"],
    "mainURL": "",
    "endpoint": "",
    "method": "",
    "headers_additional": {},
    "payload": null,
    "expected_status": "",
    "expected_response_schema": "",
    "expected_response": null,
    "extract_values": [
      {
        "from": "db_result",
        "key": "0.valid_account_id",
        "assign_to": "valid_account_id"
      }
    ],
    "validate": {},
    "test_data_file": "",
    "db_type": "mssql",
    "db_connection_name": "account_service",
    "db_query": "WITH Latest AS (SELECT Id, ROW_NUMBER() OVER (PARTITION BY Id ORDER BY Version DESC) AS rn FROM dbo.Account WHERE IsDeleted=0) SELECT TOP 1 LOWER(CAST(a.Id AS varchar(36))) AS valid_account_id FROM Latest l JOIN dbo.Account a ON l.Id=a.Id AND l.rn=1 WHERE a.ChangeState='Funded' AND a.Status='Confirmed' AND a.IsDeleted=0 ORDER BY a.Id",
    "test_summary": "Setup TC000: Fetch a valid accountId from Accounts DB (latest Funded/Confirmed version)"
  },
