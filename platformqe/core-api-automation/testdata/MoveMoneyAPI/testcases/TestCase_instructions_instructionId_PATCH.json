[
    {
        "test_id": "TC001_SETUP",
        "service_name": "MoveMoneyAPI",
        "workflow_mode": "sequential",
        "test_name": "GET /instructions/{instructionId} [setup: fetch current version] (TC001_SETUP)",
        "protocol": "REST",
        "test_type": [
            "Functional"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/instructions/{{instructionId}}",
        "method": "GET",
        "headers_additional": {
            "Accept": "application/json"
        },
        "payload": null,
        "expected_status": "200",
        "expected_response_schema": null,
        "expected_response": null,
        "ignore_fields": [
            "id"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "version",
                "assign_to": "currentVersion"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 500
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{instructionId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "InstructionId should not be empty"
                },
                {
                    "actual": "{{currentVersion}}",
                    "expected": 0,
                    "operator": ">",
                    "message": "Current version should be fetched from GET response"
                }
            ],
            "data_comparison": [
                {
                    "comparison_name": "API response self-compare",
                    "source": "api_response",
                    "target": "api_response",
                    "fields_to_compare": [],
                    "log_differences": true
                }
            ]
        },
        "test_data_file": "MoveMoneyAPI/data_driven/Data_instructions_instructionId_PATCH.csv",
        "csv_row_index": 0,
        "test_summary": "Test TC001_SETUP: Fetch current instruction version before PATCH"
    },
