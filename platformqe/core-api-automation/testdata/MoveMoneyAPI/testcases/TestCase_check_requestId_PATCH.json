[
    {
        "test_id": "TC001_SETUP",
        "service_name": "movemoney",
        "workflow_mode": "sequential",
        "test_name": "GET /check/{requestId} [setup: fetch current version] (TC001_SETUP)",
        "protocol": "REST",
        "test_type": [
            "Functional"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/check/{{requestId}}",
        "method": "GET",
        "headers_additional": {
            "Accept": "application/json"
        },
        "payload": null,
        "expected_status": "200",
        "expected_response_schema": null,
        "expected_response": null,
        "ignore_fields": [
            "id"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "version",
                "assign_to": "currentVersion"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 500
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{requestId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "RequestId should not be empty"
                },
                {
                    "actual": "{{currentVersion}}",
                    "expected": 0,
                    "operator": ">",
                    "message": "Current version should be fetched from GET response"
                }
            ],
            "data_comparison": [
                {
                    "comparison_name": "API response self-compare",
                    "source": "api_response",
                    "target": "api_response",
                    "fields_to_compare": [],
                    "log_differences": true
                }
            ]
        },
        "test_data_file": "MoveMoneyAPI/data_driven/Data_Check_PATCH.csv",
