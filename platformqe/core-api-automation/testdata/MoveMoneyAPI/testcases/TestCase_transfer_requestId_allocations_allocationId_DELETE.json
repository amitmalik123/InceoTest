[
    {
        "test_id": "TC001_SETUP",
        "service_name": "movemoney",
        "workflow_mode": "sequential",
        "test_name": "TC001_SETUP - POST /transfer/{requestId}/allocations - Create allocation for delete flow",
        "protocol": "REST",
        "test_type": [
            "Functional"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/{{requestId}}/allocations",
        "method": "POST",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": {
            "accountId": "{{accountId}}",
            "allocationUnitType": "{{allocationUnitType}}",
            "percent": "{{percent}}"
        },
        "expected_status": "200",
        "ignore_fields": [
            "id",
            "createdDate",
            "modifiedDate",
            "timestamp"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "allocationId",
                "assign_to": "latestAllocationIdForDelete"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 5000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{requestId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "RequestId should not be empty"
                },
                {
                    "actual": "{{latestAllocationIdForDelete}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Request allocationId should not be empty"
                }
            ],
            "data_comparison": [
                {
                    "comparison_name": "AllocationId match between API and DB",
                    "source": "response_allocationId",
                    "target": "db_allocationId",
                    "log_differences": true
                },
                {
                    "comparison_name": "AccountId match between API and DB",
                    "source": "response_accountId",
                    "target": "db_accountId",
                    "log_differences": true
                },
                {
                    "comparison_name": "Amount match between API and DB",
                    "source": "response_amount",
                    "target": "db_amount",
                    "log_differences": true
                }
            ]
        },
        "test_data_file": "MoveMoneyAPI/data_driven/Data_transfer_requestId_allocations_allocationId_DELETE.csv",
        "csv_row_index": 0,
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT TOP (1) a.[value] AS LatestAllocationJson, LOWER(COALESCE(JSON_VALUE(a.[value], '$.AllocationId'), JSON_VALUE(a.[value], '$.allocationId'))) AS allocationId FROM dbo.MoneyMovementRequest r CROSS APPLY OPENJSON(r.Allocations) a WHERE r.RequestId = '{{requestId}}' ORDER BY TRY_CONVERT(int, a.[key]) DESC",
            "audit_query": ""
        },
        "db_type": "mssql",
        "db_connection_name": "movemoney",
        "test_summary": "TC001_SETUP creates an allocation and captures allocationId for delete validation"
    },
