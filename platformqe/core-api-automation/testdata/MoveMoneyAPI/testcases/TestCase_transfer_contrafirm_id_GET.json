            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "200",
        "expected_response_schema": "",
        "expected_response": null,
        "ignore_fields": [
            "id"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "contraFirm.contraFirm_ID",
                "assign_to": "firm_id"
            },
            {
                "from": "response",
                "key": "contraFirm.firmName",
                "assign_to": "firm_name"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 1000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "data_comparison": [
                {
                    "source": "api_response",
                    "target": "api_response",
                    "fields_to_compare": [
                        {
                            "source_field": "contraFirm.contraFirm_ID",
                            "target_field": "contraFirm.contraFirm_ID",
                            "operator": "=="
                        },
                        {
                            "source_field": "contraFirm.firmName",
                            "target_field": "contraFirm.firmName",
                            "operator": "=="
                        },
                        {
                            "source_field": "success",
                            "target_field": "success",
                            "operator": "=="
                        }
                    ],
                    "log_differences": true,
                    "comparison_name": "Verify contraFirm object structure and key fields exist"
                }
            ],
            "assertions": [
                {
                    "actual": "{{firm_id}}",
                    "expected": 0,
                    "operator": ">",
                    "message": "Firm ID should be greater than 0"
                },
                {
                    "actual": "{{firm_name}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Firm name should not be empty"
                }
            ]
        },
