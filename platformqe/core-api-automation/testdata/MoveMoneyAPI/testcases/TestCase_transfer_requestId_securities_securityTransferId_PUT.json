[
    {
        "test_id": "TC001",
        "service_name": "MoveMoneyAPI",
        "workflow_mode": "parallel",
        "test_name": "Replaces an existing security transfer for a given money movement transfer request. [positive] (TC001)",
        "protocol": "REST",
        "test_type": [
            "Functional"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/{{requestId}}/securities/{{securityTransferId}}",
        "method": "PUT",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": "MoveMoneyAPI/payloads/Payload_transfer_requestId_securities_securityTransferId_PUT.json",
        "expected_status": "200",
        "expected_response_schema": null,
        "expected_response": null,
        "ignore_fields": [
            "id",
            "createdDate",
            "modifiedDate",
            "timestamp"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "securityTransferId",
                "assign_to": "response_SecurityTransferId"
            },
            {
                "from": "response",
                "key": "securityId",
                "assign_to": "response_securityId"
            },
            {
                "from": "response",
                "key": "securityUnitType",
                "assign_to": "response_securityUnitType"
            },
            {
                "from": "response",
                "key": "quantity",
                "assign_to": "response_quantity"
            },
            {
                "from": "db_result",
                "query": "default",
                "assign": [
                    {
                        "key": "0.securityTransferId",
                        "assign_to": "db_securityTransferId"
                    },
                    {
                        "key": "0.securityId",
                        "assign_to": "db_securityId"
                    },
                    {
                        "key": "0.securityUnitType",
                        "assign_to": "db_securityUnitType"
                    },
                    {
                        "key": "0.quantity",
                        "assign_to": "db_quantity"
                    }
                ]
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 5000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{requestId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Request ID should not be empty"
                },
                {
                    "actual": "{{securityTransferId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Security Transfer ID should not be empty"
                },
                {
                    "actual": "{{securityId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Security ID should not be empty"
                },
                {
                    "actual": "{{securityUnitType}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Security Unit Type should not be empty"
                },
                {
                    "actual": "{{quantity}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Quantity should not be empty"
                }
            ],
            "data_comparison": [
                {
                    "source": "response_SecurityTransferId",
                    "target": "db_securityTransferId",
                    "log_differences": true,
                    "comparison_name": "SecurityTransferId match between API and DB"
                },
                {
                    "source": "response_securityId",
                    "target": "db_securityId",
                    "log_differences": true,
                    "comparison_name": "SecurityId match between API and DB"
                },
                {
                    "source": "response_securityUnitType",
                    "target": "db_securityUnitType",
                    "log_differences": true,
                    "comparison_name": "SecurityUnitType match between API and DB"
                },
                {
                    "source": "response_quantity",
                    "target": "db_quantity",
                    "log_differences": true,
                    "comparison_name": "Quantity match between API and DB"
                }
            ]
        },
        "test_data_file": "MoveMoneyAPI/data_driven/Data_transfer_requestId_securities_securityTransferId_PUT.csv",
        "csv_row_index": 0,
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT LOWER([SecurityTransferId]) AS securityTransferId, LOWER([SecurityId]) AS securityId, [SecurityUnitType] AS securityUnitType, [Quantity] AS quantity FROM [dbo].[MoneyMovementRequest] WHERE [SecurityTransferId] = '{{securityTransferId}}'",
            "audit_query": ""
        },
        "db_type": "mssql",
        "db_connection_name": "movemoney",
        "test_summary": "Verify successful 200 response for security transfer update with valid request Replaces the selected security record"
    },
