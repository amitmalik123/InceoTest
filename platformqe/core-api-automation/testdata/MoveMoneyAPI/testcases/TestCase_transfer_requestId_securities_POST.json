        "protocol": "REST",
        "test_type": [
            "Functional"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/{{requestId}}/securities",
        "method": "POST",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": "MoveMoneyAPI/payloads/Payload_transfer_requestId_securities_POST_functional.json",
        "expected_status": "201",
        "expected_response_schema": null,
        "expected_response": null,
        "ignore_fields": [
            "id",
            "createdDate",
            "modifiedDate",
            "timestamp"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "securityTransferId",
                "assign_to": "response_SecurityTransfers"
            },
            {
                "from": "response",
                "key": "securityId",
                "assign_to": "response_securityId"
            },
            {
                "from": "response",
                "key": "securityUnitType",
                "assign_to": "response_securityUnitType"
            },
            {
                "from": "response",
                "key": "quantity",
                "assign_to": "response_quantity"
            },
            {
                "from": "db_result",
                "query": "default",
                "assign": [
                    {
                        "key": "0.securityTransfers",
                        "assign_to": "db_securityTransfers"
                    },
                    {
                        "key": "0.securityId",
                        "assign_to": "db_securityId"
                    },
                    {
                        "key": "0.securityUnitType",
                        "assign_to": "db_securityUnitType"
                    },
                    {
                        "key": "0.quantity",
                        "assign_to": "db_quantity"
                    }
                ]
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 5000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{requestId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Request ID should not be empty"
                },
                {
                    "actual": "{{securityId}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Security ID should not be empty"
                },
                {
                    "actual": "{{securityUnitType}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Security Unit Type should not be empty"
                },
                {
                    "actual": "{{quantity}}",
                    "expected": "",
                    "operator": "!=",
                    "message": "Quantity should not be empty"
                }
            ],
            "data_comparison": [
                {
                    "source": "response_SecurityTransfers",
                    "target": "db_securityTransfers",
                    "log_differences": true,
                    "comparison_name": "SecurityTransferId match between API and DB"
                },
                {
                    "source": "response_securityId",
                    "target": "db_securityId",
                    "log_differences": true,
                    "comparison_name": "SecurityId match between API and DB"
                },
                {
                    "source": "response_securityUnitType",
                    "target": "db_securityUnitType",
                    "log_differences": true,
                    "comparison_name": "SecurityUnitType match between API and DB"
                },
                {
                    "source": "response_quantity",
                    "target": "db_quantity",
                    "log_differences": true,
                    "comparison_name": "Quantity match between API and DB"
                }
            ]
        },
        "test_data_file": "MoveMoneyAPI/data_driven/Data_transfer_requestId_Securities_POST.csv",
        "csv_row_index": 0,
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT LOWER([SecurityTransferId]) AS securityTransfers, LOWER([SecurityId]) AS securityId, [SecurityUnitType] AS securityUnitType, [Quantity] AS quantity FROM [dbo].[MoneyMovementRequest] WHERE [SecurityTransferId] = '{{response_SecurityTransfers}}'",
            "audit_query": ""
        },
        "db_type": "mssql",
        "db_connection_name": "movemoney",
