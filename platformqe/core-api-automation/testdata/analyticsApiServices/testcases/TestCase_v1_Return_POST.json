[
    {
        "test_id": "TC_RiskVsReturn_001",
        "service_name": "analyticsApiServices",
        "workflow_mode": "sequential",
        "test_name": "POST /v1/analytics - Risk vs Return Calculation (TC_RiskVsReturn_001)",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Smoke"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/v1/analytics",
        "method": "POST",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": "analyticsApiServices/payloads/Payload_RiskVsReturn_POST.txt",
        "expected_status": "200",
        "expected_response_schema": "",
        "expected_response": null,
        "ignore_fields": [],
        "scripts": [
            "analyticsApiServices/validators/return_validator.py"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "calculationResults.0.calculationType",
                "assign_to": "api_calculation_type"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.cumulativeReturn",
                "assign_to": "blend_cumulative_return"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.annualizedReturn",
                "assign_to": "blend_annualized_return"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.blend.0.id",
                "assign_to": "blend_model_1_id"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.blend.0.entityType",
                "assign_to": "blend_model_1_entity_type"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.blend.0.cumulativeReturn",
                "assign_to": "blend_model_1_cumulative_return"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.blend.0.annualizedReturn",
                "assign_to": "blend_model_1_annualized_return"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.1.id",
                "assign_to": "benchmark_id"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.1.entityType",
                "assign_to": "benchmark_entity_type"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.1.cumulativeReturn",
                "assign_to": "benchmark_cumulative_return"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.1.annualizedReturn",
                "assign_to": "benchmark_annualized_return"
            },
            {
                "from": "script_result",
                "key": "computed_model_1_cumulative",
                "assign_to": "computed_model_1_cumulative"
            },
            {
                "from": "script_result",
                "key": "computed_model_1_annualized",
                "assign_to": "computed_model_1_annualized"
            },
            {
                "from": "script_result",
                "key": "computed_blend_cumulative",
                "assign_to": "computed_blend_cumulative"
            },
            {
                "from": "script_result",
                "key": "computed_blend_annualized",
                "assign_to": "computed_blend_annualized"
            },
            {
                "from": "script_result",
                "key": "computed_benchmark_cumulative",
                "assign_to": "computed_benchmark_cumulative"
            },
            {
                "from": "script_result",
                "key": "computed_benchmark_annualized",
                "assign_to": "computed_benchmark_annualized"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": null
            },
            "assertions": [
                {
                    "actual": "{{api_calculation_type}}",
                    "operator": "==",
                    "expected": "return",
                    "message": "Verify correct calculation type is 'return'"
                },
                {
                    "actual": "{{blend_model_1_cumulative_return}}",
                    "operator": "==",
                    "expected": "{{computed_model_1_cumulative}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blend Model 1 Cumulative Return"
                },
                {
                    "actual": "{{blend_model_1_annualized_return}}",
                    "operator": "==",
                    "expected": "{{computed_model_1_annualized}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blend Model 1 Annualized Return"
                },
                {
                    "actual": "{{blend_cumulative_return}}",
                    "operator": "==",
                    "expected": "{{computed_blend_cumulative}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blended Portfolio Cumulative Return"
                },
                {
                    "actual": "{{blend_annualized_return}}",
                    "operator": "==",
                    "expected": "{{computed_blend_annualized}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blended Portfolio Annualized Return"
                },
                {
                    "actual": "{{benchmark_cumulative_return}}",
                    "operator": "==",
                    "expected": "{{computed_benchmark_cumulative}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Benchmark Cumulative Return"
                },
                {
                    "actual": "{{benchmark_annualized_return}}",
                    "operator": "==",
                    "expected": "{{computed_benchmark_annualized}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Benchmark Annualized Return"
                },
                {
                    "actual": "{{benchmark_entity_type}}",
                    "operator": "==",
                    "expected": "benchmark",
                    "message": "Verify benchmark entity type is 'benchmark'"
                },
                {
                    "actual": "{{blend_model_1_entity_type}}",
                    "operator": "==",
                    "expected": "model",
                    "message": "Verify first blend model entity type is 'model'"
                }
            ]
        },
        "test_data_file": "analyticsApiServices/data_driven/Data_Return_POST.csv",
        "db_queries": {},
        "db_type": "mssql",
        "db_connection_name": "am_db",
        "db_query_timing": "before_api",
        "test_summary": "Test Risk vs Return API calculation. Validates risk score, return score, and sharpe ratio calculations for blended portfolios.",
        "test_scenario": "Validate risk vs return API response contains correct risk metrics, return calculations, and sharpe ratio for model blends."
    }
]