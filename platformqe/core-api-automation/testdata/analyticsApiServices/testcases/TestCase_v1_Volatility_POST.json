[
    {
        "test_id": "TC_Volatility_001",
        "service_name": "analyticsApiServices",
        "workflow_mode": "sequential",
        "test_name": "POST /v1/analytics - Volatility Calculation (TC_Volatility_001)",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Smoke"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/v1/analytics",
        "method": "POST",
