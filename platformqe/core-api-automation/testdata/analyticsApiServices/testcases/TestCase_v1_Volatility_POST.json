            {
                "from": "response",
                "key": "calculationResults.0.result.0.blend.1.id",
                "assign_to": "blend_model_2_id"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.blend.1.entityType",
                "assign_to": "blend_model_2_entity_type"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.0.blend.1.volatility",
