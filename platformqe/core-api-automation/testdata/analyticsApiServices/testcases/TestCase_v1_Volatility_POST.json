            {
                "from": "response",
                "key": "calculationResults.0.result.1.id",
                "assign_to": "benchmark_id"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.1.entityType",
                "assign_to": "benchmark_entity_type"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.1.volatility",
                "assign_to": "benchmark_volatility"
            },
            {
                "from": "response",
                "key": "calculationResults.0.result.1.annualizedVolatility",
                "assign_to": "benchmark_annualized_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_model_1_volatility",
                "assign_to": "computed_model_1_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_model_1_annualized_volatility",
                "assign_to": "computed_model_1_annualized_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_model_2_volatility",
                "assign_to": "computed_model_2_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_model_2_annualized_volatility",
                "assign_to": "computed_model_2_annualized_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_blend_volatility",
                "assign_to": "computed_blend_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_blend_annualized_volatility",
                "assign_to": "computed_blend_annualized_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_benchmark_volatility",
                "assign_to": "computed_benchmark_volatility"
            },
            {
                "from": "script_result",
                "key": "computed_benchmark_annualized_volatility",
                "assign_to": "computed_benchmark_annualized_volatility"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": null
            },
            "assertions": [
                {
                    "actual": "{{api_calculation_type}}",
                    "operator": "==",
                    "expected": "volatility",
                    "message": "Verify correct calculation type is 'volatility'"
                },
                {
                    "actual": "{{blend_model_1_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_model_1_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blend Model 1 Monthly Volatility"
                },
                {
                    "actual": "{{blend_model_1_annualized_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_model_1_annualized_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blend Model 1 Annualized Volatility"
                },
                {
                    "actual": "{{blend_model_2_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_model_2_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blend Model 2 Monthly Volatility"
                },
                {
                    "actual": "{{blend_model_2_annualized_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_model_2_annualized_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blend Model 2 Annualized Volatility"
                },
                {
                    "actual": "{{blend_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_blend_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blended Portfolio Monthly Volatility"
                },
                {
                    "actual": "{{blend_annualized_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_blend_annualized_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Blended Portfolio Annualized Volatility"
                },
                {
                    "actual": "{{benchmark_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_benchmark_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Benchmark Monthly Volatility"
                },
                {
                    "actual": "{{benchmark_annualized_volatility}}",
                    "operator": "==",
                    "expected": "{{computed_benchmark_annualized_volatility}}",
                    "tolerance": 0.0001,
                    "message": "API vs Computed: Benchmark Annualized Volatility"
                },
                {
                    "actual": "{{benchmark_entity_type}}",
                    "operator": "==",
                    "expected": "benchmark",
                    "message": "Verify benchmark entity type is 'benchmark'"
                },
                {
                    "actual": "{{blend_model_1_entity_type}}",
                    "operator": "==",
                    "expected": "model",
                    "message": "Verify first blend model entity type is 'model'"
                },
                {
                    "actual": "{{blend_model_2_entity_type}}",
                    "operator": "==",
                    "expected": "model",
                    "message": "Verify second blend model entity type is 'model'"
                }
            ]
        },
        "test_data_file": "analyticsApiServices/data_driven/Data_Volatility_POST.csv",
        "db_queries": {},
        "db_type": "mssql",
