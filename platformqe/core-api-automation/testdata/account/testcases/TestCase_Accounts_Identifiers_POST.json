    {
        "test_id": "TC001",
        "service_name": "account_service",
        "workflow_mode": "sequential",
        "test_name": "POST /accounts/{accountId}/identifiers [positive: 201 add APL identifier] (TC001)",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Regression",
            "Positive"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/accounts/{{setupAccountId}}/identifiers",
        "method": "POST",
        "rpc_method": "",
        "graphql_query": "",
        "graphql_variables": "",
        "soap_action": "",
        "soap_envelope": "",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": "account/payloads/Payload_Accounts_Identifiers_POST_APL_valid.json",
        "expected_status": "400",
        "expected_response_schema": "",
        "expected_response": null,
        "ignore_fields": [],
        "extract_values": [
            {
                "from": "response",
                "key": "identifiers.0.value",
                "assign_to": "postedIdentifierValue"
            },
            {
                "from": "response",
                "key": "identifiers.0.type",
                "assign_to": "postedIdentifierType"
            },
            {
                "from": "db_result",
                "query": "default",
                "assign": [
                    {
                        "key": "0.value",
                        "assign_to": "db_apl_value"
                    }
                ]
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 3000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [],
            "data_comparison": []
        },
        "test_data_file": "",
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT TOP 1 JSON_VALUE(i.value, '$.Value') AS value FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY Id ORDER BY Version DESC) AS vrn FROM Account) a CROSS APPLY OPENJSON(a.Identifiers) i WHERE a.vrn = 1 AND a.Id = '{{setupAccountId}}' AND JSON_VALUE(i.value, '$.Type') = 'APL';"
        },
        "db_type": "mssql",
        "db_connection_name": "account_service",
        "test_summary": "Test TC001: POST /accounts/{accountId}/identifiers with a valid APL identifier. Expects HTTP 201 Created. Validates that the response contains the identifier with the correct type and value, and that the value is persisted in the database."
    },
