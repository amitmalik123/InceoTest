    {
        "test_id": "TC001",
        "service_name": "account_service",
        "workflow_mode": "sequential",
        "test_name": "PUT /accounts/{accountId}/identifiers/APL [positive: full replace, 200 OK] (TC001)",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Regression",
            "Positive"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/accounts/{{setupAccountId}}/identifiers/APL",
        "method": "PUT",
        "rpc_method": "",
        "graphql_query": "",
        "graphql_variables": "",
        "soap_action": "",
        "soap_envelope": "",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": "account\\payloads\\Payload_Accounts_Identifier_PUT_APL_valid.json",
        "expected_status": "200",
        "expected_response_schema": "account\\schemas\\Schema_Accounts_Identifier_PUT_200.json",
        "expected_response": null,
        "ignore_fields": [],
        "extract_values": [
            {
                "from": "response",
                "key": "identifiers.0.value",
                "assign_to": "updatedIdentifierValue"
            },
            {
                "from": "db_result",
                "query": "default",
                "assign": [
                    {
                        "key": "0.value",
                        "assign_to": "db_identifier_value"
                    }
                ]
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 3000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{updatedIdentifierValue}}",
                    "operator": "==",
                    "expected": "APL-QE-PUT-001",
                    "message": "Response identifier value must match the submitted replacement value"
                },
                {
                    "actual": "{{updatedIdentifierValue}}",
                    "operator": "!=",
                    "expected": "{{originalIdentifierValue}}",
                    "message": "Updated value must differ from the original (full replace occurred)"
                }
            ],
            "data_comparison": []
        },
        "test_data_file": "",
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT TOP 1 JSON_VALUE(i.value, '$.Value') AS value FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY Id ORDER BY Version DESC) AS vrn FROM Account) a CROSS APPLY OPENJSON(a.Identifiers) i WHERE a.vrn = 1 AND a.Id = '{{setupAccountId}}' AND JSON_VALUE(i.value, '$.Type') = 'APL';"
        },
        "db_type": "mssql",
        "db_connection_name": "account_service",
        "test_summary": "Test TC001: PUT /accounts/{accountId}/identifiers/APL with a valid full identifier object. Expects HTTP 200 with the updated identifier in the response and confirms the new value is persisted in the database. Validates the old value is no longer present."
    },
