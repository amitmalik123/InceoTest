[
    {
        "test_id": "TC000",
        "service_name": "account_service",
        "workflow_mode": "sequential",
        "test_name": "POST /accounts [setup] Create account with APL and AccountNumber identifiers for DELETE identifier tests (TC000)",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Regression",
            "Setup"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/accounts",
        "method": "POST",
        "rpc_method": "",
        "graphql_query": "",
        "graphql_variables": "",
        "soap_action": "",
        "soap_envelope": "",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": {
            "parentAccountId": null,
            "accountClassification": "Household",
            "accountType": "Personal",
            "accountSubType": "Individual",
            "displayName": "Test Household IdentDEL Setup {{ random_string(6) }}",
            "sortName": "Test, Household IdentDEL",
            "openDate": "2025-01-01",
            "custodialAuthorization": "Managed",
            "managingPlatform": "Internal",
            "identifiers": [
                {
                    "type": "APL",
                    "value": "APL-QE-DEL-SETUP-{{ random_string(6) }}"
                },
                {
                    "type": "AccountNumber",
                    "value": "AN-QE-DEL-SETUP-{{ random_string(6) }}"
                }
            ]
        },
        "expected_status": "201",
        "expected_response_schema": "account/schemas/Schema_Accounts_POST.json",
        "expected_response": null,
        "ignore_fields": [
            "createdDate",
            "updatedDate",
            "createdBy",
            "updatedBy",
            "version"
        ],
        "extract_values": [
            {
                "from": "response",
                "key": "account.accountId",
                "assign_to": "setupAccountId"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 3000
            },
            "assertions": [
                {
                    "actual": "{{setupAccountId}}",
                    "operator": "!=",
                    "expected": null,
                    "message": "Setup must return a non-null accountId"
                }
            ],
            "data_comparison": []
        },
        "test_data_file": "",
        "db_query": "",
        "db_type": "",
        "test_summary": "Test TC000: [Setup] Create a Household account with APL and AccountNumber identifiers. Extracts setupAccountId for use in TC001-TC008."
    },
    {
        "test_id": "TC001",
        "service_name": "account_service",
        "workflow_mode": "sequential",
        "test_name": "DELETE /accounts/{accountId}/identifiers/APL [positive: 200 remove APL identifier] (TC001)",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Regression",
            "Positive"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/accounts/{{setupAccountId}}/identifiers/APL",
        "method": "DELETE",
        "rpc_method": "",
        "graphql_query": "",
        "graphql_variables": "",
        "soap_action": "",
        "soap_envelope": "",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "200",
        "expected_response_schema": "account/schemas/Schema_Accounts_Identifiers_DELETE_204.json",
        "expected_response": null,
        "ignore_fields": [],
        "extract_values": [
            {
                "from": "db_result",
                "query": "default",
                "assign": [
                    {
                        "key": "0.apl_count",
                        "assign_to": "db_apl_count_after_delete"
                    }
                ]
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": 3000
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "assertions": [
                {
                    "actual": "{{db_apl_count_after_delete}}",
                    "operator": "==",
                    "expected": 0,
                    "message": "APL identifier must no longer exist in the database after DELETE"
                }
            ],
            "data_comparison": []
        },
        "test_data_file": "",
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT COUNT(*) AS apl_count FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY Id ORDER BY Version DESC) AS vrn FROM Account) a CROSS APPLY OPENJSON(a.Identifiers) i WHERE a.vrn = 1 AND a.Id = '{{setupAccountId}}' AND JSON_VALUE(i.value, '$.Type') = 'APL';"
        },
        "db_type": "mssql",
        "db_connection_name": "account_service",
        "test_summary": "Test TC001: DELETE /accounts/{accountId}/identifiers/APL on an account that has an APL identifier. Expects HTTP 204 No Content. DB validation confirms the APL identifier is no longer present."
    },
