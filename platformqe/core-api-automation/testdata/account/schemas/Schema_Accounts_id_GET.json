{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "account": {
      "type": "object",
      "properties": {
        "accountId": {"type": ["string", "null"], "format": "uuid"},
        "parentAccountId": {"type": ["string", "null"], "format": "uuid"},
        "changeState": {
          "type": ["string", "null"],
          "enum": ["Initiated", "Proposal", "Contract", "AtBDOrOSJ", "Rejected", "AtBDorOSJAfterRejection", "Funded", "Terminated", "Activated", "Pending", "Proposed", "InProcess", "PendingFunding"]
        },
        "status": {
          "type": ["string", "null"],
          "enum": ["Draft", "Pending", "Confirmed"]
        },
        "version": {"type": ["integer", "null"]},
        "accountClassification": {
          "type": ["string", "null"],
          "enum": ["Household", "CustodyAccount", "Sleeve"]
        },
        "accountType": {
          "type": ["string", "null"],
          "enum": ["Unknown", "Personal", "Corporate", "JointFamily", "DonorAdvisedFund", "Individual", "Trust", "Joint", "IRAs", "RetirementPlans", "BusinessAccounts", "Organizations", "Other"]
        },
        "accountSubType": {
          "type": ["string", "null"],
          "enum": ["BankorTrustCompanyNonTaxable", "BankorTrustCompanyTaxable", "Corporate", "LLC", "Partnership", "SoleProprietor", "SubCustodianFBO", "Individual", "IndividualTOD", "InheritedIRA", "InheritedIRATrust", "InheritedRothIRA", "InheritedRothIRATrust", "RolloverIRA", "RothIRA", "SEPIRA", "SimpleIRA", "TraditionalIRA", "CommunityProperty", "CommunityPropertyWROS", "CommunityPropertyWROSTOD", "JointTenantWROS", "JointTenantWROSTOD", "TenantsbyEntirety", "TenantsbyEntiretyTOD", "TenantsInCommon", "_501c", "AssetMarkCharitable", "EndowmentNonTaxable", "EndowmentTaxable", "FoundationNonTaxable", "FoundationTaxable", "_403bIndividual", "Estate", "FederallyRecognizedIndianTribe", "Guardianship", "InvestmentClub", "OtherIRA", "PersonalTrust", "UGMA", "Unspecified", "UTMA", "_401k", "_403bPlan", "DefinedBenefitPensionPlan", "Individualk", "MoneyPurchasePensionPlan", "ProfitSharingPlan", "SelfDirectedBrokerageAccount", "SelfDirectedBrokerageAccount403b", "Trust"]
        },
        "displayName": {"type": ["string", "null"], "maxLength": 255},
        "sortName": {"type": ["string", "null"], "maxLength": 255},
        "openDate": {"type": ["string", "null"], "format": "date"},
        "terminationDate": {"type": ["string", "null"], "format": "date"},
        "riskToleranceProfile": {
          "type": ["string", "null"],
          "enum": ["Conservative", "ModerateConservative", "Moderate", "ModerateGrowth", "MaximumGrowth", "Growth"]
        },
        "custodialAuthorization": {
          "type": ["string", "null"],
          "enum": ["Managed", "ReportingOnly"]
        },
        "managingPlatform": {
          "type": ["string", "null"],
          "enum": ["Internal", "Adhesion", "AMRS"]
        },
        "parties": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "partyId": {"type": ["string", "null"], "format": "uuid"},
              "roleType": {
                "type": ["string", "null"],
                "enum": ["AccountHolder", "Trustee", "Trust", "Custodian", "AuthorizedAgents", "Guardian", "Executor", "Donor", "Trustors", "Minor", "Ward", "PrimaryBeneficiary", "ContingentBeneficiary", "BeneficialOwnershipControlOwner", "BeneficialOwnershipEntityOwner", "Entity", "InterestedParty", "PowerOfAttorney", "Decedent"]
              },
              "attributes": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": ["string", "null"],
                      "enum": ["IsMailingAddress", "IsPrimary", "BeneAllocationPercentage", "BenePerStirpes", "BeneRelationship", "FAFeeId"]
                    },
                    "value": {"type": ["string", "null"], "maxLength": 255}
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "identifiers": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": ["string", "null"],
                "enum": ["APL", "AccountNumber", "AdvisorId", "AgreementVersionId", "ModelId", "Custodian", "Adhesion", "InvestmentDirectiveId", "ADSAccountId"]
              },
              "value": {"type": ["string", "null"], "maxLength": 255}
            },
            "additionalProperties": true
          }
        },
        "createdDate": {"type": ["string", "null"], "format": "date-time"},
        "updatedDate": {"type": ["string", "null"], "format": "date-time"},
        "createdBy": {"type": ["string", "null"]},
        "updatedBy": {"type": ["string", "null"]},
        "children": {
          "type": ["array", "null"],
          "items": {"$ref": "#/properties/account"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}