{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "accounts": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/AccountHierarchyDto" }
        },
        "totalCount": { "type": ["integer", "null"] },
        "page": { "type": ["integer", "null"] },
        "pageSize": { "type": ["integer", "null"] },
        "totalPages": { "type": ["integer", "null"] },
        "hasPreviousPage": { "type": ["boolean", "null"] },
        "hasNextPage": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "AccountHierarchyDto": {
      "type": "object",
      "properties": {
        "accountId": { "type": ["string", "null"], "format": "uuid" },
        "parentAccountId": { "type": ["string", "null"], "format": "uuid" },
        "changeState": {
          "type": ["string", "null"],
          "enum": [
            "Initiated", "Proposal", "Contract", "AtBDOrOSJ", "Rejected",
            "AtBDorOSJAfterRejection", "Funded", "Terminated", "Activated",
            "Pending", "Proposed", "InProcess", "PendingFunding", null
          ]
        },
        "status": {
          "type": ["string", "null"],
          "enum": ["Draft", "Pending", "Confirmed", null]
        },
        "version": { "type": ["integer", "null"] },
        "accountClassification": {
          "type": ["string", "null"],
          "enum": ["Household", "CustodyAccount", "Sleeve", null]
        },
        "accountType": {
          "type": ["string", "null"],
          "enum": [
            "Unknown", "Personal", "Corporate", "JointFamily", "DonorAdvisedFund",
            "Individual", "Trust", "Joint", "IRAs", "RetirementPlans",
            "BusinessAccounts", "Organizations", "Other", null
          ]
        },
        "accountSubType": {
          "type": ["string", "null"],
          "enum": [
            "BankorTrustCompanyNonTaxable", "BankorTrustCompanyTaxable", "Corporate", "LLC",
            "Partnership", "SoleProprietor", "SubCustodianFBO", "Individual", "IndividualTOD",
            "InheritedIRA", "InheritedIRATrust", "InheritedRothIRA", "InheritedRothIRATrust",
            "RolloverIRA", "RothIRA", "SEPIRA", "SimpleIRA", "TraditionalIRA", "CommunityProperty",
            "CommunityPropertyWROS", "CommunityPropertyWROSTOD", "JointTenantWROS", "JointTenantWROSTOD",
            "TenantsbyEntirety", "TenantsbyEntiretyTOD", "TenantsInCommon", "_501c", "AssetMarkCharitable",
            "EndowmentNonTaxable", "EndowmentTaxable", "FoundationNonTaxable", "FoundationTaxable",
            "_403bIndividual", "Estate", "FederallyRecognizedIndianTribe", "Guardianship", "InvestmentClub",
            "OtherIRA", "PersonalTrust", "UGMA", "Unspecified", "UTMA", "_401k", "_403bPlan",
            "DefinedBenefitPensionPlan", "Individualk", "MoneyPurchasePensionPlan", "ProfitSharingPlan",
            "SelfDirectedBrokerageAccount", "SelfDirectedBrokerageAccount403b", "Trust", null
          ]
        },
        "displayName": { "type": ["string", "null"], "maxLength": 255 },
        "sortName": { "type": ["string", "null"], "maxLength": 255 },
        "openDate": { "type": ["string", "null"], "format": "date" },
        "terminationDate": { "type": ["string", "null"], "format": "date" },
        "riskToleranceProfile": {
          "type": ["string", "null"],
          "enum": [
            "Conservative", "ModerateConservative", "Moderate", "ModerateGrowth",
            "MaximumGrowth", "Growth", null
          ]
        },
        "custodialAuthorization": {
          "type": ["string", "null"],
          "enum": ["Managed", "ReportingOnly", null]
        },
        "managingPlatform": {
          "type": ["string", "null"],
          "enum": ["Internal", "Adhesion", "AMRS", null]
        },
        "parties": { "type": ["array", "null"] },
        "identifiers": { "type": ["array", "null"] },
        "createdDate": { "type": ["string", "null"], "format": "date-time" },
        "updatedDate": { "type": ["string", "null"], "format": "date-time" },
        "createdBy": { "type": ["string", "null"] },
        "updatedBy": { "type": ["string", "null"] },
        "children": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/AccountHierarchyDto" }
        }
      },
      "additionalProperties": true
    }
  }
}