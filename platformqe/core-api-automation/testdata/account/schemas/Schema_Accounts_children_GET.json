                  "type": "object",
                  "properties": {
                    "type": {
                      "type": ["string", "null"],
                      "enum": ["APL", "AccountNumber", "AdvisorId", "AgreementVersionId", "ModelId", "Custodian", null]
                    },
                    "value": {"type": ["string", "null"], "maxLength": 255}
                  },
                  "additionalProperties": true
                }
