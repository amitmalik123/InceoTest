{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "accounts": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": ["string", "null"], "format": "uuid"},
              "parentaccountid": {"type": ["string", "null"], "format": "uuid"},
              "status": {
                "type": ["string", "null"],
