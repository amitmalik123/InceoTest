              },
              "version": {"type": ["integer", "null"]},
              "accountclassification": {
                "type": ["string", "null"],
                "enum": ["Household", "Registration", "Account", "Sleeve", null]
              },
              "accounttype": {
                "type": ["string", "null"],
                "enum": ["Personal", "Corporate", "JointFamily", "DonorAdvisedFund", "Individual", "Trust", "Joint", "IRAs", "RetirementPlans", "BusinessAccounts", "Organizations", "Other", null]
              },
              "accountsubtype": {
                "type": ["string", "null"],
                "enum": ["BankorTrustCompanyNonTaxable", "BankorTrustCompanyTaxable", "Corporate", "LLC", "Partnership", "SoleProprietor", "SubCustodianFBO", "Individual", "IndividualTOD", "InheritedIRA", "InheritedIRATrust", "InheritedRothIRA", "InheritedRothIRATrust", "RolloverIRA", "RothIRA", "SEPIRA", "SimpleIRA", "TraditionalIRA", "CommunityProperty", "CommunityPropertyWROS", "CommunityPropertyWROSTOD", "JointTenantWROS", "JointTenantWROSTOD", "TenantsbyEntirety", "TenantsbyEntiretyTOD", "TenantsInCommon", "_501c", "AssetMarkCharitable", "EndowmentNonTaxable", "EndowmentTaxable", "FoundationNonTaxable", "FoundationTaxable", "_403bIndividual", "Estate", "FederallyRecognizedIndianTribe", "Guardianship", "InvestmentClub", "OtherIRA", "PersonalTrust", "UGMA", "Unspecified", "UTMA", "_401k", "_403bPlan", "DefinedBenefitPensionPlan", "Individualk", "MoneyPurchasePensionPlan", "ProfitSharingPlan", "SelfDirectedBrokerageAccount", "SelfDirectedBrokerageAccount403b", "Trust", null]
              },
              "displayname": {"type": ["string", "null"], "maxLength": 255},
              "sortname": {"type": ["string", "null"], "maxLength": 255},
              "opendate": {"type": ["string", "null"], "format": "date-time"},
              "terminationdate": {"type": ["string", "null"], "format": "date-time"},
              "risktolerance": {
                "type": ["string", "null"],
                "enum": ["Conservative", "ModerateConservative", "Moderate", "ModerateGrowth", "MaximumGrowth", null]
              },
              "custodialauthorization": {
                "type": ["string", "null"],
                "enum": ["Managed", "ReportingOnly", null]
              },
              "managingplatform": {
                "type": ["string", "null"],
                "enum": ["Internal", "Adhesion", "AMRS", null]
              },
              "parties": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "properties": {
                    "partyid": {"type": ["string", "null"], "format": "uuid"},
                    "roletype": {
                      "type": ["string", "null"],
                      "enum": ["AccountHolder", "Trustee", "Trust", "Custodian", "AuthorizedAgents", "Guardian", "Executor", "Donor", "Trustors", "Minor", "Ward", "PrimaryBeneficiary", "ContingentBeneficiary", "BeneficialOwnershipControlOwner", "BeneficialOwnershipEntityOwner", "Entity", "InterestedParty", null]
                    },
                    "attributes": {
                      "type": ["array", "null"],
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": ["string", "null"],
                            "enum": ["IsMailingAddress", "IsPrimary", "BeneAllocationPercentage", "BenePerStirpes", "BeneRelationship", null]
                          },
                          "value": {"type": ["string", "null"], "maxLength": 255}
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              },
              "identifiers": {
                "type": ["array", "null"],
