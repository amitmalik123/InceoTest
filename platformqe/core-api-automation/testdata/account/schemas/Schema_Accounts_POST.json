{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AccountResponse",
  "type": "object",
  "properties": {
    "account": {
      "type": "object",
      "description": "Represents the base account data transfer object containing core account information.",
      "properties": {
        "accountId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "parentAccountId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "changeState": {
          "type": "string",
          "enum": [
            "Initiated", "Proposal", "Contract", "AtBDOrOSJ", "Rejected", "AtBDorOSJAfterRejection",
            "Funded", "Terminated", "Activated", "Pending", "Proposed", "InProcess", "PendingFunding"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["Draft", "Pending", "Confirmed"]
        },
        "version": {
          "type": "integer"
        },
        "accountClassification": {
          "type": "string",
          "enum": ["Household", "CustodyAccount", "Sleeve"]
        },
        "accountType": {
          "type": "string",
          "enum": [
            "Unknown", "Personal", "Corporate", "JointFamily", "DonorAdvisedFund", "Individual", "Trust", "Joint",
            "IRAs", "RetirementPlans", "BusinessAccounts", "Organizations", "Other"
          ]
        },
        "accountSubType": {
          "type": "string",
          "enum": [
            "BankorTrustCompanyNonTaxable", "BankorTrustCompanyTaxable", "Corporate", "LLC", "Partnership", "SoleProprietor",
            "SubCustodianFBO", "Individual", "IndividualTOD", "InheritedIRA", "InheritedIRATrust", "InheritedRothIRA",
            "InheritedRothIRATrust", "RolloverIRA", "RothIRA", "SEPIRA", "SimpleIRA", "TraditionalIRA", "CommunityProperty",
            "CommunityPropertyWROS", "CommunityPropertyWROSTOD", "JointTenantWROS", "JointTenantWROSTOD", "TenantsbyEntirety",
            "TenantsbyEntiretyTOD", "TenantsInCommon", "_501c", "AssetMarkCharitable", "EndowmentNonTaxable", "EndowmentTaxable",
            "FoundationNonTaxable", "FoundationTaxable", "_403bIndividual", "Estate", "FederallyRecognizedIndianTribe",
            "Guardianship", "InvestmentClub", "OtherIRA", "PersonalTrust", "UGMA", "Unspecified", "UTMA", "_401k", "_403bPlan",
            "DefinedBenefitPensionPlan", "Individualk", "MoneyPurchasePensionPlan", "ProfitSharingPlan", "SelfDirectedBrokerageAccount",
            "SelfDirectedBrokerageAccount403b", "Trust"
          ]
        },
        "displayName": {
          "type": ["string", "null"],
          "maxLength": 255
        },
        "sortName": {
          "type": ["string", "null"],
          "maxLength": 255
        },
        "openDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "terminationDate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "riskToleranceProfile": {
          "type": ["string", "null"],
          "enum": [
            "Conservative", "ModerateConservative", "Moderate", "ModerateGrowth", "MaximumGrowth", "Growth", null
          ]
        },
        "custodialAuthorization": {
          "type": "string",
          "enum": ["Managed", "ReportingOnly"]
        },
        "managingPlatform": {
          "type": "string",
          "enum": ["Internal", "Adhesion", "AMRS"]
        },
        "parties": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "partyId": {
                "type": ["string", "null"],
                "format": "uuid"
              },
              "roleType": {
                "type": "string",
                "enum": [
                  "AccountHolder", "Trustee", "Trust", "Custodian", "AuthorizedAgents", "Guardian", "Executor", "Donor",
                  "Trustors", "Minor", "Ward", "PrimaryBeneficiary", "ContingentBeneficiary", "BeneficialOwnershipControlOwner",
                  "BeneficialOwnershipEntityOwner", "Entity", "InterestedParty", "PowerOfAttorney"
                ]
              },
              "attributes": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "IsMailingAddress", "IsPrimary", "BeneAllocationPercentage", "BenePerStirpes", "BeneRelationship"
                      ]
                    },
                    "value": {
                      "type": ["string", "null"],
                      "maxLength": 255
                    }
                  },
                  "required": ["type"]
                }
              }
            },
            "required": ["roleType"]
          }
        },
        "identifiers": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "APL", "AccountNumber", "AdvisorId", "AgreementVersionId", "ModelId", "Custodian"
                ]
              },
              "value": {
                "type": ["string", "null"],
                "maxLength": 255
              }
            },
            "required": ["type"]
          }
        },
        "createdDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "updatedDate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "createdBy": {
          "type": ["string", "null"]
        },
        "updatedBy": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "changeState", "status", "version", "accountClassification", "accountType", "accountSubType",
        "riskToleranceProfile", "custodialAuthorization", "managingPlatform"
      ]
    }
  },
  "required": ["account"]
}