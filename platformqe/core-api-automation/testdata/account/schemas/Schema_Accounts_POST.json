{
  "type": "object",
  "properties": {
    "account": {
      "type": "object",
      "properties": {
        "parentAccountId": { "type": ["string", "null"], "format": "uuid" },
        "status": {
          "type": "string",
          "enum": [
            "Initiated", "Proposal", "Contract", "AtBDOrOSJ", "Rejected", "AtBDorOSJAfterRejection", "Funded", "Terminated", "Activated", "Pending", "Proposed", "InProcess", "PendingFunding"
          ]
        },
        "version": { "type": "integer" },
        "accountClassification": {
          "type": "string",
          "enum": ["Household", "Registration", "Account", "Sleeve"]
        },
        "accountType": {
          "type": "string",
          "enum": [
            "Personal", "Corporate", "JointFamily", "DonorAdvisedFund", "Individual", "Trust", "Joint", "IRAs", "RetirementPlans", "BusinessAccounts", "Organizations", "Other"
          ]
        },
        "accountSubType": {
          "type": "string",
          "enum": [
            "BankorTrustCompanyNonTaxable", "BankorTrustCompanyTaxable", "Corporate", "LLC", "Partnership", "SoleProprietor", "SubCustodianFBO", "Individual", "IndividualTOD", "InheritedIRA", "InheritedIRATrust", "InheritedRothIRA", "InheritedRothIRATrust", "RolloverIRA", "RothIRA", "SEPIRA", "SimpleIRA", "TraditionalIRA", "CommunityProperty", "CommunityPropertyWROS", "CommunityPropertyWROSTOD", "JointTenantWROS", "JointTenantWROSTOD", "TenantsbyEntirety", "TenantsbyEntiretyTOD", "TenantsInCommon", "_501c", "AssetMarkCharitable", "EndowmentNonTaxable", "EndowmentTaxable", "FoundationNonTaxable", "FoundationTaxable", "_403bIndividual", "Estate", "FederallyRecognizedIndianTribe", "Guardianship", "InvestmentClub", "OtherIRA", "PersonalTrust", "UGMA", "Unspecified", "UTMA", "_401k", "_403bPlan", "DefinedBenefitPensionPlan", "Individualk", "MoneyPurchasePensionPlan", "ProfitSharingPlan", "SelfDirectedBrokerageAccount", "SelfDirectedBrokerageAccount403b", "Trust"
          ]
        },
        "displayName": { "type": ["string", "null"], "maxLength": 255, "minLength": 0 },
        "sortName": { "type": ["string", "null"], "maxLength": 255, "minLength": 0 },
        "openDate": { "type": "string", "format": "date-time" },
        "terminationDate": { "type": ["string", "null"], "format": "date-time" },
        "riskToleranceProfile": {
          "type": ["string", "null"],
          "enum": ["Conservative", "ModerateConservative", "Moderate", "ModerateGrowth", "MaximumGrowth", "Growth"]
        },
        "custodialAuthorization": {
          "type": "string",
          "enum": ["Managed", "ReportingOnly"]
        },
        "managingPlatform": {
          "type": "string",
          "enum": ["Internal", "Adhesion", "AMRS"]
        },
        "parties": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": ["string", "null"], "format": "uuid" },
              "roleType": {
                "type": "string",
                "enum": [
                  "AccountHolder", "Trustee", "Trust", "Custodian", "AuthorizedAgents", "Guardian", "Executor", "Donor", "Trustors", "Minor", "Ward", "PrimaryBeneficiary", "ContingentBeneficiary", "BeneficialOwnershipControlOwner", "BeneficialOwnershipEntityOwner", "Entity", "InterestedParty"
                ]
              },
              "attributes": {
                "type": ["array", "null"],
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["IsMailingAddress", "IsPrimary", "BeneAllocationPercentage", "BenePerStirpes", "BeneRelationship"]
                    },
                    "value": { "type": ["string", "null"], "maxLength": 255, "minLength": 0 }
                  },
                  "required": ["type"]
                }
              }
            },
            "required": ["id", "roleType"]
          }
        },
        "identifiers": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["APL", "AccountNumber", "AdvisorId", "AgreementVersionId", "ModelId", "Custodian"]
              },
              "value": { "type": ["string", "null"], "maxLength": 255, "minLength": 0 }
            },
            "required": ["type"]
          }
        }
      },
      "required": [
        "status", "version", "accountClassification", "accountType", "accountSubType", "displayName", "sortName", "openDate", "riskToleranceProfile", "custodialAuthorization", "managingPlatform"
      ]
    }
  },
  "required": ["account"]
}