{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unhandled Server Error Response",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "enum": ["Unhandled Server Error"],
      "description": "Short description of the error"
    },
    "status": {
      "type": "integer",
      "enum": [500],
      "description": "HTTP status code indicating internal server error"
    },
    "detail": {
      "type": "string",
      "description": "Detailed error message explaining the server error"
    }
  },
  "required": ["title", "status", "detail"],
  "additionalProperties": false
}
