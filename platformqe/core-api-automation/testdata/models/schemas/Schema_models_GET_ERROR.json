{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Server Error Response",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short description of the error"
    },
    "status": {
      "type": "integer",
      "description": "HTTP status code"
    },
    "detail": {
      "type": "string",
      "description": "Detailed error message"
    },
    "type": {
      "type": "string",
      "description": "A URI reference identifying the problem type (RFC 9457 AC2)"
    },
    "instance": {
      "type": "string",
      "description": "A URI reference that identifies the specific occurrence / request path (RFC 9457 AC5)"
    }
  },
  "required": [
    "title",
    "status",
    "detail",
    "type",
    "instance"
  ],
  "additionalProperties": true
}