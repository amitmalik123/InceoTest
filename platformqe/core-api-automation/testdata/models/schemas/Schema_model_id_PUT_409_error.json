{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conflict Error Response",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "https://assetmark.atlassian.net/wiki/spaces/PE/pages/2303590438/Standard+Error+Codes+and+Messaging#already-exists"
      ],
      "description": "Error type identifier"
    },
    "title": {
      "type": "string",
      "description": "Short error code or title"
    },
    "status": {
      "type": "integer",
      "enum": [
        409
      ],
      "description": "HTTP status code for conflict"
    },
    "detail": {
      "type": "string",
      "description": "Detailed error message"
    },
    "instance": {
      "type": "string",
      "description": "A URI reference that identifies the specific occurrence / request path (RFC 9457 AC5)"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "detail",
    "instance"
  ],
  "additionalProperties": false
}