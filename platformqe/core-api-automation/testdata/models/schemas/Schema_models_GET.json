{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "version": { "type": "integer" },
          "modelType": { "type": ["string", "null"] },
          "solutionType": { "type": ["string", "null"] },
          "custodian": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mandate": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            }
          },
          "investmentApproach": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" }
            }
          },
          "benchmarks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" }
              }
            }
          },
          "investmentMin": {
            "type": "object",
            "properties": {
              "additionalProp1": { "type": "number" },
              "additionalProp2": { "type": "number" },
              "additionalProp3": { "type": "number" }
            }
          },
          "riskProfile": { "type": ["string", "null"] },
          "owner": {
            "type": "object",
            "properties": {
              "ownerId": { "type": "string", "format": "uuid" }
            }
          },
          "holdings": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "properties": {
                "entityType": { "type": "string" },
                "allocationName": { "type": "string" },
                "modelId": { "type": ["string", "null"], "format": "uuid" },
                "cusip": { "type": "string" },
                "ticker": { "type": "string" },
                "weight": { "type": "number" },
                "allocations": {
                  "type": ["array", "null"],
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "entityType": { "type": "string" },
                      "assetType": { "type": "string" },
                      "assetClass": { "type": "string" },
                      "assetSubClass": { "type": "string" },
                      "weight": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "analytics": {
            "type": "object",
            "properties": {
              "estimatedYields": {
                "type": "array",
                "items": {}
              },
              "tenYearReturn": { "type": "number" },
              "tenYearVolatility": { "type": "number" }
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "additionalProp1": { "type": "string" },
              "additionalProp2": { "type": "string" },
              "additionalProp3": { "type": "string" }
            }
          },
          "publishedDate": { "type": ["string", "null"], "format": "date-time" },
          "modifiedDate": { "type": ["string", "null"], "format": "date-time" },
          "modifiedBy": { "type": ["string", "null"], "format": "uuid" },
          "createdBy": { "type": ["string", "null"], "format": "uuid" }
        },
        "required": [
          "modelId",
          "name",
          "status",
          "version",
          "modelType",
          "solutionType",
          "custodian",
          "mandate",
          "investmentApproach",
          "benchmarks",
          "investmentMin",
          "riskProfile",
          "owner",
          "holdings",
          "analytics",
          "metadata"
        ]
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "id": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "ownerId": { "type": ["string", "null"] }
      }
    },
    "count": { "type": "integer" }
  },
  "required": ["models", "filters", "count"]
}
