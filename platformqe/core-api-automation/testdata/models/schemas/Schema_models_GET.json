{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modelId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "modelType": { "type": ["string", "null"] },
          "solutionType": { "type": ["string", "null"] },
          "mandate": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            }
          },
          "investmentApproach": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" }
            }
          },
          "owner": {
            "type": "object",
            "properties": {
              "ownerId": { "type": "string", "format": "uuid" }
            }
          },
          "metadata": {
            "type": ["object", "null"]
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "allocations": {
                  "type": ["array", "null"],
                  "items": {
                    "type": "object",
                    "properties": {
                      "entityType": { "type": "string" },
                      "allocationName": { "type": "string" },
                      "modelId": { "type": ["string", "null"], "format": "uuid" },
                      "cusip": { "type": "string" },
                      "ticker": { "type": "string" },
                      "weight": { "type": "number" },
                      "allocations": {
                        "type": ["array", "null"],
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": { "type": "string" },
                            "entityType": { "type": "string" },
                            "assetType": { "type": "string" },
                            "assetClass": { "type": "string" },
                            "assetSubClass": { "type": "string" },
                            "weight": { "type": "number" }
                          }
                        }
                      }
                    }
                  }
                },
                "analytics": {
                  "type": ["object", "null"],
                  "properties": {
                    "estimatedYields": {
                      "type": "array",
                      "items": {}
                    },
                    "tenYearReturn": {
                      "oneOf": [
                        { "type": "number" },
                        {
                          "type": "object",
                          "properties": {
                            "annualized": { "type": "number" },
                            "cumulative": { "type": "number" }
                          }
                        }
                      ]
                    },
                    "tenYearVolatility": {
                      "oneOf": [
                        { "type": "number" },
                        {
                          "type": "object",
                          "properties": {
                            "annualized": { "type": "number" },
                            "cumulative": { "type": "number" }
                          }
                        }
                      ]
                    }
                  }
                },
                "version": { "type": "integer" },
                "benchmarks": {
                  "type": ["array", "null"],
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" }
                    }
                  }
                },
                "investmentMins": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string" },
                          "value": { "type": "number" }
                        },
                        "required": ["type", "value"]
                      },
                      "minItems": 0
                    },
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "riskProfile": { "type": ["string", "null"] },
                "metadata": {
                  "type": ["object", "null"]
                },
                "custodians": {
                  "type": ["array", "null"],
                  "items": { "type": "string" }
                },
                "status": { "type": "string" },
                "publishedDate": { "type": ["string", "null"], "format": "date-time" },
                "modifiedDate": { "type": ["string", "null"], "format": "date-time" },
                "modifiedBy": { "type": ["string", "null"], "format": "uuid" },
                "createdBy": { "type": ["string", "null"], "format": "uuid" }
              },
              "required": ["allocations", "version", "status", "publishedDate", "modifiedDate", "modifiedBy", "createdBy"]
            }
          },
          "modifiedDate": { "type": ["string", "null"], "format": "date-time" },
          "modifiedBy": { "type": ["string", "null"], "format": "uuid" },
          "createdBy": { "type": ["string", "null"], "format": "uuid" }
        },
        "required": [
          "modelId",
          "name",
          "modelType",
          "solutionType",
          "mandate",
          "investmentApproach",
          "owner",
          "metadata",
          "versions"
        ]
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "id": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "ownerId": { "type": ["string", "null"] }
      }
    },
    "count": { "type": "integer" }
  },
  "required": ["models", "filters", "count"]
}
