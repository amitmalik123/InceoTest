{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Not Found Error Response",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "format": "uri",
      "description": "Reference URI for the error type"
    },
    "title": {
      "type": "string",
      "description": "Short description of the error"
    },
    "status": {
      "type": "integer",
      "enum": [404],
      "description": "HTTP status code for Not Found"
    },
    "detail": {
      "type": "string",
      "description": "Human-readable explanation"
    },
    "instance": {
      "type": "string",
      "description": "A URI reference that identifies the specific occurrence / request path (RFC 9457 AC5)"
    }
  },
  "required": ["type", "title", "status", "detail", "instance"],
  "additionalProperties": false
}
