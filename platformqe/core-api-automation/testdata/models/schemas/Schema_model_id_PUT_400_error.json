{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Invalid JSON Error Response",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "enum": ["Invalid JSON"],
      "description": "Short description of the error"
    },
    "status": {
      "type": "integer",
      "enum": [400],
      "description": "HTTP status code indicating a bad request"
    },
    "detail": {
      "type": "string",
      "description": "Detailed error message explaining the invalid JSON payload"
    }
  },
  "required": ["title", "status", "detail"],
  "additionalProperties": false
}
