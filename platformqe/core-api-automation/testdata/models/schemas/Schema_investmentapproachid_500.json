{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error Response Schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short summary of the error"
    },
    "status": {
      "type": "integer",
      "description": "HTTP-like status code representing the error"
    },
    "detail": {
      "type": "string",
      "description": "Detailed description of the error"
    },
    "type": {
      "type": "string",
      "description": "A URI reference identifying the problem type (RFC 9457 AC2)"
    },
    "instance": {
      "type": "string",
      "description": "A URI reference that identifies the specific occurrence / request path (RFC 9457 AC5)"
    }
  },
  "required": [
    "title",
    "status",
    "detail",
    "type",
    "instance"
  ],
  "additionalProperties": false
}