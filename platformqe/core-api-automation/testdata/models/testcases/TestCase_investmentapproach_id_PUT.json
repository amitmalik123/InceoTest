    {
        "test_id": "TC003",
        "service_name": "models",
        "workflow_mode": "sequential",
        "test_name": "Update Investment Approach with Random Data and Verify DB Changes (TC003)",
        "protocol": "REST",
        "test_type": [
            "Functional",
            "Database Validation"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/investmentapproach/{{first_investment_approach_id}}",
        "method": "PUT",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": {
            "name": "{{random_string(20)}}",
            "isActive": true
        },
        "expected_status": "200",
        "expected_response_schema": "models/schemas/Schema_updateInvApproachRequest.json",
        "expected_response": {
            "status": 200,
            "error": "Request successful"
        },
        "ignore_fields": [
            "id"
        ],
        "extract_values": [
            {
                "from": "request",
                "key": "name",
                "assign_to": "updated_random_name"
            }
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": null
            },
            "security": {
                "checks": [
                    "sql_injection",
                    "xss"
                ]
            },
            "data_comparison": [
                {
                    "source": "api_response",
                    "source_array_path": "status",
                    "target": "literal",
                    "target_literal": 200,
                    "comparison_name": "Verify status is 200"
                },
                {
                    "source": "api_response",
                    "source_array_path": "error",
                    "target": "literal",
                    "target_literal": "Request successful",
                    "comparison_name": "Verify Message is 'Request successful'"
                },
                {
                    "source": "updated_random_name",
                    "target": "db_result",
                    "target_query": "default",
                    "target_array_path": "0.name",
                    "log_differences": true,
                    "comparison_name": "Verify updated name in database matches request payload"
                },
                {
                    "source": "db_result",
                    "source_array_path": "0.is_active",
                    "target": "literal",
                    "target_literal": true,
                    "comparison_name": "Verify isActive is true in database"
                }
            ]
        },
        "test_data_file": "",
        "db_query_timing": "after_api",
        "db_queries": {
            "default": "SELECT investment_approach_id, name, is_active, modified_by FROM public.investment_approach WHERE investment_approach_id = {{first_investment_approach_id}};"
        },
        "db_type": "postgresql",
        "db_connection_name": "models",
        "test_summary": "Test TC003: Update investment approach with random name and isActive=true, then validate the changes in database"
    },
