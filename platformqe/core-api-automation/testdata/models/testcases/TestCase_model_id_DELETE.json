        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/models/{{response_model_id}}/publish",
        "method": "POST",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "422",
        "expected_response_schema": "models/schemas/Schema_model_id_PUT_422_error.json",
        "expected_response": {
            "type": "https://assetmark.atlassian.net/wiki/spaces/PE/pages/2303590438/Standard+Error+Codes+and+Messaging#invalid-request",
