    {
        "test_id": "TC003",
        "service_name": "models",
        "workflow_mode": "independent",
        "test_name": "DELETE /model/{id} - Negative Test: Non-existent Model ID",
        "protocol": "REST",
        "test_type": [
            "Negative"
        ],
        "mainURL": "{{base_url}}",
        "endpoint": "/models/99999999-9999-9999-9999-999999999999",
        "method": "DELETE",
        "headers_additional": {
            "Content-Type": "application/json"
        },
        "payload": null,
        "expected_status": "404",
        "expected_response": {
            "type": "https://assetmark.atlassian.net/wiki/spaces/PE/pages/2303590438/Standard+Error+Codes+and+Messaging#resource-not-found",
            "title": "Resource Not Found",
            "status": 404,
            "detail": "Unable to find model 99999999-9999-9999-9999-999999999999",
            "instance": "/api/models/v1/models/99999999-9999-9999-9999-999999999999"
        },
        "ignore_fields": [
            "instance"
        ],
        "validate": {
            "performance": {
                "max_response_time_ms": null
            },
            "assertions": [
                {
                    "actual": "{{del03_type}}",
                    "operator": "!=",
                    "expected": "ResourceNotFound",
                    "message": "AC2: type must not be non-URI value 'ResourceNotFound'"
                },
                {
                    "actual": "{{del03_type}}",
                    "operator": "!=",
                    "expected": "InvalidInput",
                    "message": "AC2: type must not be non-URI value 'InvalidInput'"
                },
                {
                    "actual": "{{del03_type}}",
                    "operator": "!=",
                    "expected": "BusinessRuleViolation",
                    "message": "AC2: type must not be non-URI value 'BusinessRuleViolation'"
                },
                {
                    "actual": "{{del03_type}}",
                    "operator": "!=",
                    "expected": null,
                    "message": "AC1: type field must be present"
                },
                {
                    "actual": "{{del03_type}}",
                    "operator": "!=",
                    "expected": "",
                    "message": "AC2: type must not be empty string"
                },
                {
                    "actual": "{{del03_title}}",
                    "operator": "!=",
                    "expected": "Model.NotFound",
                    "message": "AC3: title must not be internal code 'Model.NotFound'"
                },
                {
                    "actual": "{{del03_title}}",
                    "operator": "!=",
                    "expected": "Model.InvalidId",
                    "message": "AC3: title must not be internal code 'Model.InvalidId'"
                },
                {
                    "actual": "{{del03_title}}",
                    "operator": "!=",
                    "expected": "Model.MismatchVersionModelId",
                    "message": "AC3: title must not be internal code 'Model.MismatchVersionModelId'"
                },
                {
                    "actual": "{{del03_title}}",
                    "operator": "!=",
                    "expected": null,
                    "message": "AC1: title must be present"
                },
                {
                    "actual": "{{del03_title}}",
                    "operator": "!=",
                    "expected": "",
                    "message": "AC3: title must not be empty string"
                },
                {
                    "actual": "{{del03_status}}",
                    "operator": "==",
                    "expected": 404,
                    "message": "AC4: status in body must equal HTTP 404"
                },
                {
                    "actual": "{{del03_detail}}",
                    "operator": "!=",
                    "expected": null,
                    "message": "AC1: detail must be present"
                },
                {
                    "actual": "{{del03_detail}}",
                    "operator": "!=",
                    "expected": "",
                    "message": "AC1: detail must not be empty"
                },
                {
                    "actual": "{{del03_instance}}",
                    "operator": "!=",
                    "expected": null,
                    "message": "AC5: instance must be present"
                },
                {
                    "actual": "{{del03_instance}}",
                    "operator": "!=",
                    "expected": "",
                    "message": "AC5: instance must contain the request path"
                },
                {
                    "actual": "{{del03_type}}",
                    "operator": "==",
                    "expected": "https://assetmark.atlassian.net/wiki/spaces/PE/pages/2303590438/Standard+Error+Codes+and+Messaging#resource-not-found",
                    "message": "AC2: type must be RFC 9457 URI for resource-not-found"
                },
                {
                    "actual": "{{del03_title}}",
                    "operator": "==",
                    "expected": "Resource Not Found",
                    "message": "AC3: title must be human-readable 'Resource Not Found'"
                }
            ]
        },
        "test_summary": "Negative Test: Attempt to delete a non-existent model ID",
        "test_scenario": "Verify appropriate error response when trying to delete a model that doesn't exist",
        "expected_response_schema": "models/schemas/Schema_error_404.json",
        "extract_values": [
            {
                "from": "response",
                "key": "type",
                "assign_to": "del03_type"
            },
            {
                "from": "response",
                "key": "title",
                "assign_to": "del03_title"
            },
            {
                "from": "response",
                "key": "status",
                "assign_to": "del03_status"
            },
            {
                "from": "response",
                "key": "detail",
                "assign_to": "del03_detail"
            },
            {
                "from": "response",
                "key": "instance",
                "assign_to": "del03_instance"
            }
        ]
    }
