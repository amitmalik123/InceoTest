# Flake8 configuration
[flake8]
# Maximum line length
max-line-length = 100

# Maximum complexity
# Increase complexity threshold to reduce noise from large helper functions
max-complexity = 20

# Exclude directories
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    allure-results,
    reports,
    traces,
    screenshots,
    videos,
    .idea,
    .vscode

# Ignore specific errors
ignore =
    E203,
    E266,
    E501,
    W503,
    W504,
    D100,
    D104,
    D107

# Docstring conventions
docstring-convention = google

# Per-file ignores
per-file-ignores =
    __init__.py:F401,D104
    conftest.py:D103
    tests/*:D103
    features/steps/*:D103

# Enable specific warnings
select =
    E,    # pycodestyle errors
    W,    # pycodestyle warnings
    F,    # pyflakes
    C,    # mccabe complexity
    B,    # flake8-bugbear
    SIM,  # flake8-simplify

# Show source code for errors
show-source = True

# Show statistics
statistics = True

# Count errors
count = True
