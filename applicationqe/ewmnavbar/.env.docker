# Docker Environment Configuration for EWM-NavBar Tests
# Based on influx_reporter.py environment variables
# Copy this to .env or use with: docker-compose --env-file .env.docker

# Environment Selection (test or dev)
ENV=test

# Test Execution Configuration (from playwright.config.ts)
URL=http://assetmark-test.com
TIMEOUT=180000
WORKERS=1
RETRIES=2
SLOW_MO=0

# CI/CD Detection
CI=true

# Browser Configuration
BROWSER=chromium
HEADLESS=true

# Debug Settings
DEBUG=false
PLAYWRIGHT_DEBUG=false

# InfluxDB Configuration (from influx_reporter.py)
# Default values match influx_reporter.py initialization
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=default
INFLUXDB_BUCKET=AutomationData
INFLUXDB_TOKEN=test-token-12345

# InfluxDB Service Configuration (for docker-compose influxdb service)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=password123
INFLUX_PORT=8086
INFLUX_RETENTION=30d
INFLUX_DATA_PATH=./influxdb-data

# Reporter Configuration (from influx_reporter.py)
BUILD_ID=docker-local
BUILD_REASON=Manual
ENVIRONMENT=test
ALLURE_RESULTS_DIR=/app/target/allure-results

# Authentication & Storage
AUTH_STORAGE_PATH=./auth-storage

# Azure Pipelines Integration (optional - for artifact links in reporter)
SYSTEM_TEAMPROJECT=ProdEng
BUILD_BUILDID=docker-local

# Python Reporter Configuration
PYTHONUNBUFFERABLE=1

# Docker Resource Limits (adjust based on system)
# These are defined in docker-compose.yml under deploy.resources
