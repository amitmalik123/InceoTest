{
    "compilerOptions": {
        "target": "ES2017",
        "module": "CommonJS",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "lib": [
            "ES2015",
            "DOM"
        ],
        "paths": {
            "@data/*": [
                "./data/*"
            ],
            "@helperfunctions/*": [
                "./helperfunctions/*"
            ],
            "@pages/*": [
                "./pages/*"
            ],
            "@fixtures/*": [
                "./fixtures/*"
            ]
        }
    }
}